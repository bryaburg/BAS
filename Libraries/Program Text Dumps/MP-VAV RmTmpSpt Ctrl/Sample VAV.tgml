        </Bind>
        <Script Name="Enable Animations" OnDocumentLoad="OnDocumentLoad" OnSignalChange="OnSignalChange"><![CDATA[var component;
var animations;

function OnDocumentLoad(evt){
    component = evt.getCurrentTarget();
    // Get a list of all Animate tags in the component and default them all to stopped
    animations = component.getElementsByTagName("Animate");
    for(var i=0; i<animations.length; i++)
        animations.item(i).setAttribute("Animation","Stop");
    
    // Set to/from properties of each animation based on the position of the next line in the fan blades list   
    var fanblades = component.getChild("Fan").getElementsByTagName("Line");    
    for(var j=0; j<fanblades.length; j++){
        var XYanimations = fanblades.item(j).getElementsByTagName("Animate");
        for(var k=0; k<4; k++){
            XYanimations.item(k).setAttribute("From", fanblades.item(j).getAttribute(XYanimations.item(k).getAttribute("Name")));
            if(j==fanblades.length-1)
                XYanimations.item(k).setAttribute("To", fanblades.item(0).getAttribute(XYanimations.item(k).getAttribute("Name")));
            else
                XYanimations.item(k).setAttribute("To", fanblades.item(j+1).getAttribute(XYanimations.item(k).getAttribute("Name")));
        }
    }
}

function OnSignalChange(evt){
    evt.preventDefault();
    var value = evt.getValue();
    // If fan status is one, set all Animate tags to start, otherwise stop
    if(value>0)
        for(var i=0; i<animations.length; i++)
            animations.item(i).setAttribute("Animation","Start");
    else
        for(var i=0; i<animations.length; i++)
            animations.item(i).setAttribute("Animation","Stop");
}]]></Script>
    </Component>
