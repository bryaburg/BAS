            PathData="M74.99999957412109,25.0 C74.99999957412109,29.4 71.3999995741211,33.0 66.99999957412109,33.0 62.49999957412109,33.0 58.99999957412109,29.4 58.99999957412109,25.0 58.99999957412109,20.5 62.49999957412109,17.0 66.99999957412109,17.0 71.3999995741211,17.0 74.99999957412109,20.5 74.99999957412109,25.0 z M62.99999957412109,10.5 L85.99999957412109,10.5 85.99999957412109,28.5 62.99999957412109,28.5 z"
