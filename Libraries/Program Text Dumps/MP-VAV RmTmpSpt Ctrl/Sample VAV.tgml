                    <Bind Name="Temperature.Value">
                        <Script Name="7 Segment Display"
                            OnDocumentLoad="" OnMouseClick="" OnSignalChange="OnSignalChange"><![CDATA[var on = "#333333";
var off = "#10000000";

function OnSignalChange(evt){
	evt.preventDefault();
    component = evt.getTarget().getParentNode();
	value = new Number(evt.getValue());
	dp = component.getChild("dp");
	output = "";
	output += value.toFixed(1);
	
	if ((value >= 100) | (value <= -10) | isNaN(value))
		output = "---";

    dp.setAttribute("Fill", on);
	clearDigits();
    try{
        setDigits(output);
    }
    catch(ex){
        setDigits("---");    
    }
}

function setDigits(output){
	length = output.length;
	j = -1;
	
    for(i=length-1; i>=0; --i){
		display = output.slice(i,i+1);
        if(display != "."){
            j++;
			digit = component.getChildByName("g"+j);
            decoder(digit,display);	
        }
	}
}

function clearDigits(){
    for(i=0; i<=2; ++i){
		digit = component.getChild("g"+i);
		decoder(digit, " ");
	}
}

function decoder(digit,display){
	
	switch (display){
		case " ":
			digit.getChild("a").setAttribute("Fill", off);
			digit.getChild("b").setAttribute("Fill", off);
			digit.getChild("c").setAttribute("Fill", off);
			digit.getChild("d").setAttribute("Fill", off);
			digit.getChild("e").setAttribute("Fill", off);
			digit.getChild("f").setAttribute("Fill", off);
			digit.getChild("g").setAttribute("Fill", off);
			break;
		case "-":
			digit.getChild("a").setAttribute("Fill", off);
			digit.getChild("b").setAttribute("Fill", off);
			digit.getChild("c").setAttribute("Fill", off);
			digit.getChild("d").setAttribute("Fill", off);
			digit.getChild("e").setAttribute("Fill", off);
			digit.getChild("f").setAttribute("Fill", off);
			digit.getChild("g").setAttribute("Fill", on);
			break;
		case "0":
			digit.getChild("a").setAttribute("Fill", on);
			digit.getChild("b").setAttribute("Fill", on);
			digit.getChild("c").setAttribute("Fill", on);
			digit.getChild("d").setAttribute("Fill", on);
			digit.getChild("e").setAttribute("Fill", on);
			digit.getChild("f").setAttribute("Fill", on);
			digit.getChild("g").setAttribute("Fill", off);
			break;
		case "1":
			digit.getChild("a").setAttribute("Fill", off);
			digit.getChild("b").setAttribute("Fill", on);
			digit.getChild("c").setAttribute("Fill", on);
			digit.getChild("d").setAttribute("Fill", off);
			digit.getChild("e").setAttribute("Fill", off);
			digit.getChild("f").setAttribute("Fill", off);
			digit.getChild("g").setAttribute("Fill", off);
			break;
		case "2":
			digit.getChild("a").setAttribute("Fill", on);
			digit.getChild("b").setAttribute("Fill", on);
			digit.getChild("c").setAttribute("Fill", off);
			digit.getChild("d").setAttribute("Fill", on);
			digit.getChild("e").setAttribute("Fill", on);
			digit.getChild("f").setAttribute("Fill", off);
			digit.getChild("g").setAttribute("Fill", on);
			break;
		case "3":
			digit.getChild("a").setAttribute("Fill", on);
			digit.getChild("b").setAttribute("Fill", on);
			digit.getChild("c").setAttribute("Fill", on);
			digit.getChild("d").setAttribute("Fill", on);
			digit.getChild("e").setAttribute("Fill", off);
			digit.getChild("f").setAttribute("Fill", off);
			digit.getChild("g").setAttribute("Fill", on);
			break;
		case "4":
			digit.getChild("a").setAttribute("Fill", off);
			digit.getChild("b").setAttribute("Fill", on);
			digit.getChild("c").setAttribute("Fill", on);
			digit.getChild("d").setAttribute("Fill", off);
			digit.getChild("e").setAttribute("Fill", off);
			digit.getChild("f").setAttribute("Fill", on);
			digit.getChild("g").setAttribute("Fill", on);
			break;
		case "5":
			digit.getChild("a").setAttribute("Fill", on);
			digit.getChild("b").setAttribute("Fill", off);
			digit.getChild("c").setAttribute("Fill", on);
			digit.getChild("d").setAttribute("Fill", on);
			digit.getChild("e").setAttribute("Fill", off);
			digit.getChild("f").setAttribute("Fill", on);
			digit.getChild("g").setAttribute("Fill", on);
