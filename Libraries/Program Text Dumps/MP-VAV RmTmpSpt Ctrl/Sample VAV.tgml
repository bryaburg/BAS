                    OnSignalChange="onChange"
                        Stroke="#993DCD58"><![CDATA[var onValue;
var val;
var onColour;
var offColour;
var comp;
function onLoad(evt)
{
comp = evt.getCurrentTarget().getParentNode();
onValue = comp.getAttribute("OnValue").split(',');
var scr = comp.getElementsByTagName("Script").item(0);
onColour = scr.getAttribute("Stroke");
offColour = scr.getAttribute("Fill"); 
}

function onChange(evt){
    evt.preventDefault();
    val = evt.getValue();
    if (getBool(val)){
        comp.setAttribute("Fill",onColour);
    }
    else{
        comp.setAttribute("Fill",offColour);
    }
}

function getBool(val){
    for (var i=0;i<onValue.length;i++){
        if (val == true || val == false){
        val = val.toString();
        }
        else{
            if (isNumber(val)){
                val = Math.round(parseFloat(val));
                val = val.toString();
            }
        }
        if(String(val).toLowerCase() == String(onValue[i]).toLowerCase())
        {
            return true;
        }
    }
    return false;
}

function isNumber (o) {
  return ! isNaN (o-0) && o != null;
}]]><Expose
                        ExposedAttribute="Fill" Name="Schedule Off Colour"/>
