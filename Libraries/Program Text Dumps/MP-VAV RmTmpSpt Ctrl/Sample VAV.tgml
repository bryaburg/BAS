        <Script Name="Resize Title Bar" OnSignalChange="OnSignalChange"><![CDATA[function OnSignalChange(evt){
    var title = evt.getCurrentTarget();
    var text = title.getElementsByTagName("Text").item(0);
    var rectangle = title.getElementsByTagName("Rectangle").item(0);
    var triangle = title.getElementsByTagName("Component").item(0);    
    
    var value = String(evt.getValue()).substring(0,155);
    text.setAttribute("Content",value);
    
    var textWidth = Math.max(text.getBoundingBox().get_Width(), 135);
    
    rectangle.setAttribute("Width",textWidth+10);
    triangle.setAttribute("Left",textWidth+10);
}]]></Script>
