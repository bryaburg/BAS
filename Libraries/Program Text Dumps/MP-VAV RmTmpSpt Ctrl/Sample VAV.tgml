        <Script Fill="#333333" OnDocumentLoad="onLoad"
            OnMouseClick="mClick" OnMouseDown="onDown" OnMouseOut="mOut"
            OnMouseOver="mOver" OnMouseUp="onUp"
            OnSignalChange="onChange"
                Stroke="#3DCD58"><![CDATA[var comp;
var root;
var opn = false;
var aniArr = new Array;
var From;
var To;
var note1 = "";
var note2 = "";
var notes;
var noNotes;

function mOver(evt){
    for(var i=0; i < aniArr.length; i++){
        triggerAni(aniArr.item(i), To, From);
    }
}

function mOut(evt){
    for(var i=0; i < aniArr.length; i++){
        triggerAni(aniArr.item(i), From, To);
    }
}

function mClick(evt){
    if (opn){
        comp.getChild("Close").setAttribute("Visibility", "Hidden");
        comp.getChild("Expand").setAttribute("Visibility", "Visible");
        try{
            triggerAni(root.getChild("Notes").getChildRecursive("ani"), "0", "1");
        }
        catch(err){
            NotifyError();
        }
        opn = false;
    }
    else{
        comp.getChild("Close").setAttribute("Visibility", "Visible");
        comp.getChild("Expand").setAttribute("Visibility", "Hidden");
        try{
            triggerAni(root.getChild("Notes").getChildRecursive("ani"), "1", "0");
        }
        catch(err){
            NotifyError();
        }
        opn = true;
    }
    try{
        root.appendChild(root.getChild("Notes"));
    }
    catch(err){}
}

function onLoad(evt)
{
    comp = evt.getCurrentTarget();
    aniArr = comp.getElementsByTagName("Animate");
    root = comp.getOwnerDocument().getDocumentElement();
    var scr = comp.getElementsByTagName("Script").item(0);
    From = scr.getAttribute("Fill");
    notes=comp.getAttribute("Stroke");
    noNotes=comp.getAttribute("Fill");  
    To = scr.getAttribute("Stroke");
    var top = Math.min(Number(comp.getAttribute("Top")),590);
    
    try{
        root.getChild("Notes").getChild("VAV").setAttribute("Top",top);
    } catch(err){
        NotifyError();
    }
}

function onUp(evt)
{
    for(var i=0; i < aniArr.length; i++){
        triggerAni(aniArr.item(i), From, "#626469");
    }
}

function onDown(evt)
{
    for(var i=0; i < aniArr.length; i++){
        triggerAni(aniArr.item(i), "#626469", To );
    }
}

function triggerAni(ani, t, f){
    if (ani != null){
        ani.setAttribute("Animation", "Stop");
        ani.setAttribute("From", f);
        ani.setAttribute("To", t);
        ani.setAttribute("Animation", "Start");
    }
}

function onChange(evt){
    if(evt.getTarget().getFullBindName()=="VAV.NOTE1") note1=evt.getValue()+"";
    if(evt.getTarget().getFullBindName()=="VAV.NOTE2") note2=evt.getValue()+"";
    var col = noNotes;
    if((note1.length+note2.length)>0){
        var col=notes;
    }
    From = col;
    for(var i=0; i < aniArr.length; i++){
        aniArr.item(i).setAttribute("From",col);
    }
    comp.getChildRecursive("img").setAttribute("Fill",col);
    comp.getChildRecursive("Text1").setAttribute("Stroke",col);
    comp.getChildRecursive("Text2").setAttribute("Stroke",col);
}

function NotifyError(evt){
    alert("Notes Layer Does Not Exist");
}]]><Expose
                ExposedAttribute="Fill" Name="Icon Symbol Fill"/>
            <Expose ExposedAttribute="Stroke" Name="Icon Symbol Mouse Over"/>
        </Script>
