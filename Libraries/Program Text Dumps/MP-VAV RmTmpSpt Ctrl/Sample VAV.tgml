    <Script Id="Global Tooltip Script" Name="" OnDocumentLoad="Load"
        OnMouseMove="Move" OnMouseOut="Out" OnMouseOver="Over"><![CDATA[// Constants
var TOOLTIPID = "GlobalTooltip";
var SAFETYGAP = 20;
// Global variables
var Document;
var Tooltip;
// OnDocumentLoad event
function Load (evt) {
    // Get owner document
    Document = evt.getCurrentTarget().getOwnerDocument();
        // Get document size
    var DocumentElement = Document.getDocumentElement();
    var DocumentWidth = new Number(DocumentElement.getAttribute("Width"));
    var DocumentHeight = new Number(DocumentElement.getAttribute("Height"));
        // Get tooltip element by id
    var TooltipElement = Document.getElementById(TOOLTIPID);
        // Put tooltip on top
    DocumentElement.appendChild(TooltipElement);
        // New tooltip
    Tooltip = new Tooltip(TooltipElement, DocumentWidth, DocumentHeight);
        // Disable tooltip
    Tooltip.disable();
}

// OnMouseOver event
function Over (evt) {
    // Get element and document element
    var Element = evt.getTarget();
    // Get Tooltip attribute
    var TooltipValue = "";
    var TooltipText = new String(Element.getAttribute("Tooltip"));  
    // Check if there is a tooltip text
    if (TooltipText.length > 0) {
        // Enable and move tooltip
        Tooltip.enable(TooltipText+TooltipValue);
        Tooltip.move(evt.getScreenX(), evt.getScreenY());
    }
}

// OnMouseOut event
function Out (evt) {
    // Disable tooltip
    Tooltip.disable();
}

// OnMouseMove event
function Move (evt) {
    // Move tooltip
    Tooltip.move(evt.getScreenX(), evt.getScreenY());
}

// Tooltip class
function Tooltip (Component, MaxWidth, MaxHeight) {
    // Properties
    this.component = Component;
        this.shade = Component.getChildByName("Shade");
    this.frame = Component.getChildByName("Frame");
    this.text = Component.getChildByName("Text");
    this.fade = Component.getChildByName("Fade");
        this.scaleWidth = new Number(this.component.getAttribute("Width")) / new Number(this.component.getAttribute("ContentWidth"));
    this.scaleWidth = new Number(this.component.getAttribute("Height")) / new Number(this.component.getAttribute("ContentHeight"));
        this.maxWidth = MaxWidth;
    this.maxHeight = MaxHeight;
        // Enable tooltip
    this.enable = function (TooltipText) {
        // Check if tooltip text has changed
        if (TooltipText != this.text.getAttribute("Content")) {
            // Update text
            this.text.setAttribute("Content", TooltipText);
                        // Calculate frame width
            var TextMargin = new Number(this.text.getAttribute("Left"));
            var TooltipWidth = this.text.getBoundingBox().get_Width() + TextMargin * 2;
                        // Set tooltip width
            this.frame.setAttribute("Width", TooltipWidth);
            this.shade.setAttribute("Width", TooltipWidth+4);
            this.component.setAttribute("ContentWidth", TooltipWidth);
            this.component.setAttribute("Width", TooltipWidth * this.scaleWidth);
        }
        
        // Show tooltip
        this.component.setAttribute("Visibility", "Visible");
    }
    
    // Disable tooltip
    this.disable = function () {
        // Hide tooltip
        this.component.setAttribute("Visibility", "Hidden");
    }
    
    // Move tooltip
    this.move = function (X, Y) {
        // Check if tooltip is allowed to move
        if (this.component.getAttribute("Visibility") == "Visible") {
            // Get component size
            var Width = new Number(this.component.getAttribute("Width"));
            var Height = new Number(this.component.getAttribute("Height"));
                        // Calculate left and top position
            var Left = (X + Width < this.maxWidth) ? X: X - Width;
            var Top = (Y + SAFETYGAP + Height < this.maxHeight) ? Y + SAFETYGAP: Y - SAFETYGAP - Height;
                        // Set new position
            this.component.setAttribute("Left", Left);
            this.component.setAttribute("Top", Top);
        }
    }
}]]></Script>
