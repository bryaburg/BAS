        <Script Id="UniversalPoint v3.2C"
            Name="UniveralPoint Global Function Calls"
            OnDocumentLoad="OnDocumentLoad" OnMouseClick="OnMouseClick"
            OnMouseDown="" OnMouseMove="" OnMouseOut="" OnMouseOver=""
            OnMouseUp="" OnSignalChange="OnSignalChange"><![CDATA[var component;

function OnDocumentLoad(evt){
    try{
        component = evt.getCurrentTarget();
        global.UniversalPointOnDocumentLoad(evt);
    }catch(err){
        global.handleError(err,component);
    }    
}

function OnSignalChange(evt){
    try{
        global.UniversalPointOnSignalChange(evt);
    }catch(err){
        global.handleError(err,component);
    }            
}

function OnMouseClick(evt){
    try{
        global.UniversalPointOnMouseClick(evt);
    }catch(err){
        global.handleError(err,component);
    }        
}]]></Script>
