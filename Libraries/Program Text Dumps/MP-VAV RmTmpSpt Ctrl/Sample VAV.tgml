                    <Script Name="Damper Animation"
                        OnDocumentLoad="OnDocumentLoad" OnSignalChange="OnSignalChange"><![CDATA[var open0 = [];
var open25 = [];
var open50 = [];
var open75 = [];
var open100 = [];

function storeCoordinate(xVal, yVal, array){
    array.push({x: xVal, y: yVal});
}

function OnSignalChange(evt){
    var path = evt.getTarget().getParentNode();
    var value = evt.getValue();
    var pathdata = "";    
    var range = value % 25;    

    for(i=0; i<13; i++){
        if(i==0) pathdata = "M";
        if(i==1) pathdata += "C";
        
        switch(true){
            case (value < 25):
                pathdata += ((open25[i].x-open0[i].x)*range/25+open0[i].x).toFixed(3);
                pathdata += ",";
                pathdata += ((open25[i].y-open0[i].y)*range/25+open0[i].y).toFixed(3);
                break;
            case (value < 50):
                pathdata += ((open50[i].x-open25[i].x)*range/25+open25[i].x).toFixed(3);
                pathdata += ",";
                pathdata += ((open50[i].y-open25[i].y)*range/25+open25[i].y).toFixed(3);       
                break;
            case (value < 75):
                pathdata += ((open75[i].x-open50[i].x)*range/25+open50[i].x).toFixed(3);
                pathdata += ",";
                pathdata += ((open75[i].y-open50[i].y)*range/25+open50[i].y).toFixed(3);        
                break;
            case (value < 100):
                pathdata += ((open100[i].x-open75[i].x)*range/25+open75[i].x).toFixed(3);
                pathdata += ",";
                pathdata += ((open100[i].y-open75[i].y)*range/25+open75[i].y).toFixed(3); 
                break;
            default:
                pathdata = "M15.984,45.434 C1.693,44.37 -9.604,37.898 -9.247,30.976 -8.89,24.053 2.985,19.305 17.276,20.368 31.568,21.433 42.865,27.905 42.508,34.827 42.152,41.749 30.277,46.498 15.984,45.434";
        }
        
        pathdata += " ";
        if(i==12) pathdata += "z";
    }    
   
    path.setAttribute("PathData", pathdata);
}

function OnDocumentLoad(evt){
    storeCoordinate(22.655, 33.953, open0);
    storeCoordinate(20.435, 51.349, open0);
    storeCoordinate(14.062, 64.744, open0);
