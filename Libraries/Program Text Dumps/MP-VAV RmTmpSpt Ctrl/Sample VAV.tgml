<?tgml version="1.21"?><Tgml Author="DJF" Background="#FFFFFF"
    ComponentCounter="278" GridSize="10" Height="900" LayerCounter="12"
    UseGlobalScripts="True" Width="1600">
    <Group Id="GlobalScripts V2.0.0262" Visibility="Hidden">
        <Script Id="A000" Name="Initialise" OnDocumentLoad="Initialise"><![CDATA[function Initialise(evt){/*START 000*/var titleText=Number(0);var ownerDoc=evt.getCurrentTarget().getOwnerDocument();var docElement=ownerDoc.getDocumentElement();if(docElement.getAttribute("UseGlobalScripts")!="True")try{docElement.setAttribute("UseGlobalScripts","True");ownerDoc.getElementById("GlobScrTemp").setAttribute("Visibility","Visible");ownerDoc.getElementById("GlobScrTemp").getChild("GlobScrText").setAttribute("Content",(evt.getTarget().getElementsByTagName("Script").length-1)+" global scripts temporarily enabled");var errText=docElement.getChildRecursive("GlobScrText");titleText=parseInt(docElement.getChildRecursive("TitleBg").getAttribute("Width"));errText.setAttribute("Left",titleText);errText.setAttribute("Width",1850-titleText);}catch(ex){}/*END 000*/}]]></Script>
        <Script Id="A001" Name="_onChange" OnDocumentLoad="onFirstLoad"><![CDATA[function onFirstLoad(evt){/*START 001*/_onChange=function(evt){var comp=evt.getCurrentTarget();var bindId=Number(1);if(parseInt(evt.getTarget().getAttribute("Id"))==2){bindId=2;}switch(String(evt.getTarget().getAttribute("Description"))){case"Value":comp.setAttribute("val"+bindId,evt.getValue());comp.setAttribute("stat"+bindId,parseInt(evt.getStatus()));break;case"OverrideState":comp.setAttribute("OverrideState"+bindId,String(evt.getValue()).toLowerCase());break;case"OutOfService":comp.setAttribute("OutOfService"+bindId,String(evt.getValue()).toLowerCase());break;case"ActiveCommandPriority":comp.setAttribute("ActiveCommandPriority"+bindId,parseInt(evt.getValue()));break;case"HighLevel":comp.setAttribute("HighLevel"+bindId,evt.getValue());comp.setAttribute("HighLevelstat"+bindId,parseInt(evt.getStatus()));break;case"LowLevel":comp.setAttribute("LowLevel"+bindId,evt.getValue());comp.setAttribute("LowLevelstat"+bindId,parseInt(evt.getStatus()));break;case"HighHighLevel":comp.setAttribute("HighHighLevel"+bindId,evt.getValue());comp.setAttribute("HighHighLevelstat"+bindId,parseInt(evt.getStatus()));break;case"LowLowLevel":comp.setAttribute("LowLowLevel"+bindId,evt.getValue());comp.setAttribute("LowLowLevelstat"+bindId,parseInt(evt.getStatus()));break;case"C1Value":comp.setAttribute("C1val",evt.getValue());comp.setAttribute("C1stat",parseInt(evt.getValue()));break;case"ForcedByOperator":comp.setAttribute("ForcedByOperator"+bindId,evt.getValue());break;case"Reliability":comp.setAttribute("Reliability"+bindId,parseInt(evt.getValue()));break;case"AlarmState":comp.setAttribute("AlarmState"+bindId,parseInt(evt.getValue()));evt.getTarget().setAttribute("liveValue",evt.getValue());break;case"FbkOverrideState":comp.setAttribute("FbkOverrideState",String(evt.getValue()).toLowerCase());break;case"FbkValue":comp.setAttribute("Fbkval",evt.getValue());comp.setAttribute("Fbkstat",parseInt(evt.getStatus()));break;case"CmdOverrideState":comp.setAttribute("CmdOverrideState",String(evt.getValue()).toLowerCase());break;case"CmdValue":comp.setAttribute("Cmdval",evt.getValue());comp.setAttribute("Cmdstat",parseInt(evt.getStatus()));break;case"CmdOutOfService":comp.setAttribute("CmdOutOfService",String(evt.getValue()).toLowerCase());break;case"FbkOutOfService":comp.setAttribute("FbkOutOfService",String(evt.getValue()).toLowerCase());break;case"CmdActiveCommandPriority":comp.setAttribute("CmdActiveCommandPriority",parseInt(evt.getValue()));break;case"FbkActiveCommandPriority":comp.setAttribute("FbkActiveCommandPriority",parseInt(evt.getValue()));break;case"CmdForcedByOperator":comp.setAttribute("CmdForcedByOperator",evt.getValue());break;case"FbkForcedByOperator":comp.setAttribute("FbkForcedByOperator",evt.getValue());break;}}/*END 001*/}]]></Script>
        <Script Id="A002" Name="_firstRun" OnDocumentLoad="onFirstLoad"><![CDATA[function onFirstLoad(evt){/*START 002*/_firstRun=function(evt){var language=1;var comp=evt.getCurrentTarget();var display=comp.getChildRecursive("Display");comp.setAttribute("ACP","16");comp.setAttribute("onValue",(display.getAttribute("onValue")!="")?display.getAttribute("onValue"):"");comp.setAttribute("onClr",(display.getAttribute("onClr")!="")?display.getAttribute("onClr"):display.getChild("Text").getAttribute("Stroke"));comp.setAttribute("offClr",(display.getAttribute("offClr")!="")?display.getAttribute("offClr"):display.getChild("Text").getAttribute("Stroke"));comp.setAttribute("g1",display.getChildRecursive("g1").getAttribute("Color"));comp.setAttribute("g2",display.getChildRecursive("g2").getAttribute("Color"));comp.setAttribute("TextClr",display.getChild("Text").getAttribute("Stroke"));comp.setAttribute("onText",display.getAttribute("onText"));comp.setAttribute("offText",display.getAttribute("offText"));comp.setAttribute("Units",display.getAttribute("Units"));comp.setAttribute("OOS","false");comp.setAttribute("status","2");comp.setAttribute("reliability","0");comp.setAttribute("hwOvr","false");comp.setAttribute("reqState","0");comp.setAttribute("clr","#FFFFFF");comp.setAttribute("clr2","#626469");comp.setAttribute("sWidth","1");comp.setAttribute("AlarmState1","0");comp.setAttribute("oriWidth",comp.getChildRecursive("background").getAttribute("Width"));comp.setAttribute("origRightPos",parseInt(comp.getChildRecursive("right").getAttribute("Left")));comp.setAttribute("origLeftPos",parseInt(comp.getChildRecursive("Alarm").getAttribute("Left")));}/*END 002*/}]]></Script>
        <Script Id="A003" Name="_getDigitalDisplayText" OnDocumentLoad="onFirstLoad"><![CDATA[function onFirstLoad(evt){/*START 003*/_getDigitalDisplayText=function(comp,onValue,value){var disp=comp.getChild("Display");var onClr=comp.getAttribute("Fill");var offClr=comp.getAttribute("Stroke");var Txt=disp.getChild("Text");var Txt2=disp.getChild("Text2");var tmpContent1=disp.getAttribute("offText");var tmpContent2=disp.getAttribute("offText2");var tmpCol=offClr;var weight="Normal";var autoHide="Hidden";if(_Bool(onValue,value)){autoHide="Visible";tmpCol=onClr;tmpContent1=disp.getAttribute("onText");tmpContent2=disp.getAttribute("onText2");if(comp.hasAttribute("alarm"))weight="Bold";}comp.setAttribute("TextClr",tmpCol);if(parseInt(comp.getAttribute("reliability"))==0){Txt.setAttribute("Stroke",tmpCol);Txt.setAttribute("FontWeight",weight);try{Txt2.setAttribute("Stroke",tmpCol);Txt2.setAttribute("FontWeight",weight);}catch(ex){}}if(comp.hasAttribute("autohide"))comp.setAttribute("Visibility",autoHide);var theArray=new Array();theArray.push(tmpContent1,""+tmpContent2);return(theArray);}/*END 003*/}]]></Script>
        <Script Id="A004" Name="_isNumber" OnDocumentLoad="onFirstLoad"><![CDATA[function onFirstLoad(evt){/*START 004*/_isNumber=function(o){return!isNaN(o-0)&&o!=null;}/*END 004*/}]]></Script>
        <Script Id="A005" Name="_Bool" OnDocumentLoad="onFirstLoad"><![CDATA[function onFirstLoad(evt){/*START 005*/_Bool=function(onValue,val){var len=onValue.length;for(var i=0;i<len;i++){if(String(val).toLowerCase()==String(onValue[i]).toLowerCase()){return true;}}return false;}/*END 005*/}]]></Script>
        <Script Id="A006" Name="_chkDecReq" OnDocumentLoad="onFirstLoad"><![CDATA[function onFirstLoad(evt){/*START 006*/_chkDecReq=function(bnd,units){var dec;switch(String(units)){case"hz":case"°c":case"°f":case"va":case"kva":case"var":case"kw":case"a":case"kvar":case"l/s":case"h":case"usgal/min":case"ft":case"m":case"in":dec=1;break;case"kpa":dec=2;break;case"psi":case"inh₂o":dec=3;break;default:dec=0;}return dec;}/*END 006*/}]]></Script>
        <Script Id="A007" Name="_setcoilDisplay" OnDocumentLoad="onFirstLoad"><![CDATA[function onFirstLoad(evt){/*START 007*/_setcoilDisplay=function(evt){_onChange(evt);var comp=evt.getCurrentTarget();var val=parseFloat(comp.getAttribute("val1"));var topScale=parseFloat(comp.getAttribute("TopScale"));var bottomScale=parseFloat(comp.getAttribute("BottomScale"));var scaleFactor=topScale-bottomScale;if(val>topScale)val=topScale;if(val<bottomScale)val=bottomScale;if(bottomScale==0){val=(val)/scaleFactor;}else{val=(val-scaleFactor)/scaleFactor;}var t=val;var b=Math.min(val+.01,1);if(t==b)t=t-0.01;try{comp.getChildRecursive("B").setAttribute("Offset",b);comp.getChildRecursive("T").setAttribute("Offset",t);comp.getChildRecursive("Direction").setAttribute("Opacity",val);}catch(ex){try{comp.getChildRecursive("Gas").setAttribute("ScaleX",val);}catch(ex){}}_decideStatus(evt);}/*END 007*/}]]></Script>
        <Script Id="A008" Name="_setVisuals" OnDocumentLoad="onFirstLoad"><![CDATA[function onFirstLoad(evt){/*START 008*/_setVisuals=function(evt){_onChange(evt);var comp=evt.getCurrentTarget();var OOS=comp.getAttribute("OutOfService1");var ACP=parseInt(comp.getAttribute("ActiveCommandPriority1"));var hwOvr=String(comp.getAttribute("OverrideState1")).toLowerCase();var reliability=parseInt(comp.getAttribute("Reliability1"));var status=comp.getAttribute("stat1");var AlarmState=parseInt(comp.getAttribute("AlarmState1"));var fbo=parseInt(comp.getAttribute("ForcedByOperator1"));var frc=comp.getChildRecursive("ForceComponent");var alm=comp.getChildRecursive("AlarmComponent");var db=comp.getChildRecursive("DatabaseComponent");var err=comp.getChildRecursive("NetworkComponent");var bac=comp.getChildRecursive("BACOvr");var bg=comp.getChildRecursive("background");var curve=comp.getChildRecursive("bgfill");var almAni=comp.getChildRecursive("AlmAnim");var clr=comp.getChildRecursive("background").getAttribute("Stroke");var clr2=curve.getAttribute("Fill");var reqState=0;var sWidth=1;if(String(evt.getTarget().getAttribute("Description")).toLowerCase()=="value"){_setText(evt);}var myArray=[];var myArrayLen;var allBinds=comp.getElementsByTagName("Bind");var allBLen=allBinds.length;for(var i=0;i<allBLen;i++){if(allBinds.item(i).getAttribute("Description")=="AlarmState"){var bindToAdd={Name:allBinds.item(i).getFullBindName(),Value:allBinds.item(i).getAttribute("liveValue")};myArray.push(bindToAdd);}}myArrayLen=myArray.length;var count1=0;var count2=0;var count3=0;var count4=0;var count5=0;var tt="";AlarmState=0;for(var i=0;i<myArrayLen;i++){switch(parseInt(myArray[i].Value)){case 1:count1++;break;case 2:count2++;break;case 3:count3++;break;case 4:count4++;break;case 5:count5++;break;}if(parseInt(myArray[i].Value)==4){AlarmState=4;}else if(parseInt(myArray[i].Value)==5&&AlarmState!=4){AlarmState=5;}else if(parseInt(myArray[i].Value)==1&&AlarmState!=4&&AlarmState!=5){AlarmState=1;}else if(parseInt(myArray[i].Value)==2&&AlarmState!=4&&AlarmState!=5&&AlarmState!=1){AlarmState=2;}else if(parseInt(myArray[i].Value)==3&&AlarmState!=4&&AlarmState!=5&&AlarmState!=1&&AlarmState!=2){AlarmState=3;}}if(count1>0)tt+=count1+" Active";if(count2>0){tt+=(count1>0)?","+count2+" Acknowledged":count2+" Acknowledged";}if(count3>0){tt+=(count1>0||count2>0)?","+count3+" Reset":count3+" Reset";}if(count4>0){tt+=(count1>0||count2>0||count3>0)?","+count4+" Disabled":count4+" Disabled";}if(count5>0){tt+=(count1>0||count2>0||count3>0||count4>0)?","+count5+" Fault":count5+" Fault";}if(count1+count2+count3+count4+count5==1)tt+=" Alarm";if(count1+count2+count3+count4+count5>1)tt+=" Alarms";alm.getParentNode().setAttribute("Tooltip",tt);switch(AlarmState){case 1:alm.getFirstChild().setAttribute("Fill","#FF0000");almAni.setAttribute("Animation","Start");break;case 2:alm.getFirstChild().setAttribute("Fill","#E47F00");almAni.setAttribute("Animation","Stop");break;case 3:alm.getFirstChild().setAttribute("Fill","#009530");almAni.setAttribute("Animation","Stop");break;case 4:alm.getFirstChild().setAttribute("Fill","#0000FF");almAni.setAttribute("Animation","Stop");break;case 5:alm.getFirstChild().setAttribute("Fill","#6699CC");almAni.setAttribute("Animation","Stop");break;default:alm.getFirstChild().setAttribute("Fill","#9FA0A4");almAni.setAttribute("Animation","Stop");break;}if(String(comp.getChild("Display").getAttribute("AlarmHistory")).toLowerCase()=="yes"){alm.setAttribute("Visibility","Visible");}else{alm.setAttribute("Visibility",(AlarmState!=0)?"Visible":"Hidden");}if(String(OOS)=="true"||String(OOS)==true||ACP==8||status==3||fbo==1||fbo==2){reqState=1;}if(ACP<8){reqState=5;}if(hwOvr=="true"){reqState=2;}if(status==0){reqState=3;comp.getChildRecursive("Text").setAttribute("Stroke",comp.getAttribute("TextClr"));comp.getChildRecursive("g1").setAttribute("Color",comp.getAttribute("g1"));comp.getChildRecursive("g2").setAttribute("Color",comp.getAttribute("g2"));}if(status==1){reqState=4;}if(reqState!=3){comp.getChildRecursive("Text").setAttribute("Stroke",(reliability>0)?"#FFFFFF":comp.getAttribute("TextClr"));try{comp.getChildRecursive("Text2").setAttribute("Stroke",(reliability>0)?"#FFFFFF":comp.getAttribute("TextClr"));}catch(ex){}comp.getChildRecursive("g1").setAttribute("Color",(reliability>0)?"#FF8080":comp.getAttribute("g1"));comp.getChildRecursive("g2").setAttribute("Color",(reliability>0)?"#FF0000":comp.getAttribute("g2"));}frc.setAttribute("Visibility","Hidden");db.setAttribute("Visibility","Hidden");err.setAttribute("Visibility","Hidden");bac.setAttribute("Visibility","Hidden");switch(reqState){case 2:frc.setAttribute("Visibility","Visible");clr="#F0080E";clr2="#F0080E";sWidth=2;break;case 1:frc.setAttribute("Visibility","Visible");clr="#FFD100";clr2="#FFD100";sWidth=2;break;case 5:bac.setAttribute("Visibility","Visible");clr="#FFD100";clr2="#FFD100";sWidth=2;break;case 3:err.setAttribute("Visibility","Visible");clr="#FF6000";clr2="#FF6000";sWidth=2;break;case 4:db.setAttribute("Visibility","Visible");clr="#42B4E6";clr2="#42B4E6";sWidth=2;break;default:clr="#808080";clr2="None";sWidth=1;curve.setAttribute("Stroke",clr2);curve.setAttribute("Fill",clr2);break;}bg.setAttribute("StrokeWidth",sWidth);bg.setAttribute("Stroke",clr);curve.setAttribute("Stroke",clr2);curve.setAttribute("Fill",clr2);}/*END 008*/}]]></Script>
        <Script Id="A009" Name="_setAnim" OnDocumentLoad="onFirstLoad"><![CDATA[function onFirstLoad(evt){/*START 009*/_setAnim=function(evt){_onChange(evt);var comp=evt.getCurrentTarget();if(_Bool(comp.getAttribute("onValue").split(','),comp.getAttribute("val1"))){_Animate(evt,"Start");try{comp.getChildRecursive("Animation").setAttribute("Visibility","Visible");}catch(ex){}try{comp.getChildRecursive("Cover").setAttribute("Visibility","Hidden");}catch(ex){}}else{_Animate(evt,"Stop");try{comp.getChildRecursive("Animation").setAttribute("Visibility","Hidden");}catch(ex){}try{comp.getChildRecursive("Cover").setAttribute("Visibility","Visible");}catch(ex){}}_decideStatus(evt);}/*END 009*/}]]></Script>
        <Script Id="A010" Name="_getAnalogDisplayText" OnDocumentLoad="onFirstLoad"><![CDATA[function onFirstLoad(evt){/*START 010*/_getAnalogDisplayText=function(bnd,value,dec,units){if(!units)units="";try{var str="...";if(!isNaN(value)&&value!=Infinity){if(dec==null||dec=="")dec=_chkDecReq(bnd.toLowerCase(),units.toLowerCase());str=new Number(parseFloat(value)).toFixed(dec);if(units)try{var reqdUnits=_chkUnitSwap(units);str+=(" "+reqdUnits);}catch(ex){str+=(" "+units);}}return str;}catch(ex){return"...";}}/*END 010*/}]]></Script>
        <Script Id="A011" Name="_roundUp" OnDocumentLoad="onFirstLoad"><![CDATA[function onFirstLoad(evt){/*START 011*/_roundUp=function(num,amt){return(Math.ceil(num/amt)*amt);}/*END 011*/}]]></Script>
        <Script Id="A012" Name="_setText" OnDocumentLoad="onFirstLoad"><![CDATA[function onFirstLoad(evt){/*START 012*/_setText=function(evt){var comp=evt.getCurrentTarget();var display=comp.getChild("Display");var Text=display.getChildByName("Text");var Text2=display.getChildByName("Text2");var dec=display.getAttribute("Decimals");var EngScale=display.getAttribute("EngScale");var onClr=display.getAttribute("onClr");var offClr=display.getAttribute("offClr");var onText=display.getAttribute("onText");var offText=display.getAttribute("offText");var onText2=display.getAttribute("onText2");var offText2=display.getAttribute("offText2");var oriWidth=display.getAttribute("oriWidth");var HorAlign=display.getAttribute("TextAlignment").toLowerCase().substring(0,1);var origRightPos=parseInt(display.getAttribute("origRightPos"));var origLeftPos=parseInt(display.getAttribute("origLeftPos"));if(HorAlign=="l"){var setHorAlign="Left";var tpos="2.5";}if(HorAlign=="c"){var setHorAlign="Center";var tpos=oriWidth/2;}if(HorAlign=="r"){var setHorAlign="Right";var tpos=oriWidth-2.5;}Text.setAttribute("HorizontalAlign",setHorAlign);Text.setAttribute("Left",tpos);var units=comp.getAttribute("Units");if(units==null||units==""){var units=evt.getUnit();}var onW2=0;var offW2=0;function toTitleCase(str){return str.replace(/\w\S*/g,function(txt){return txt.charAt(0).toUpperCase()+txt.substr(1).toLowerCase();});}if(evt.getTarget().hasAttribute("string")){var reqCaps=comp.getAttribute("DisplayCase").toLowerCase();var value=String(evt.getValue());if(isNaN(value)){if(reqCaps.indexOf("u")>-1)value=value.toUpperCase();if(reqCaps.indexOf("l")>-1)value=value.toLowerCase();if(reqCaps.indexOf("s")>-1)value=toTitleCase(value);Text.setAttribute("Content",value);}var onW=Text.getBoundingBox().get_Width();var offW=0;}else if(evt.getTarget().hasAttribute("onValue")){var vArray=new Array();vArray=_getDigitalDisplayText(comp,evt.getTarget().getAttribute("onValue").split(','),evt.getValue());Text.setAttribute("Content",vArray[0]);Text.setAttribute("Visibility","Hidden");Text.setAttribute("FontWeight","Bold");var orText=Text.getAttribute("Content");Text.setAttribute("Content",onText);var onW=Text.getBoundingBox().get_Width();Text.setAttribute("Content",offText);var offW=Text.getBoundingBox().get_Width();Text.setAttribute("Content",orText);Text.setAttribute("FontWeight","Normal");Text.setAttribute("Visibility","Visible");try{Text2.setAttribute("Content",vArray[1]);Text2.setAttribute("Visibility","Hidden");Text2.setAttribute("FontWeight","Bold");var orText2=Text2.getAttribute("Content");Text2.setAttribute("Content",onText2);onW2=Text2.getBoundingBox().get_Width();Text2.setAttribute("Content",offText2);offW2=Text2.getBoundingBox().get_Width();Text2.setAttribute("Content",orText2);Text2.setAttribute("FontWeight","Normal");Text2.setAttribute("Visibility","Visible");}catch(ex){}vArray=_getDigitalDisplayText(comp,evt.getTarget().getAttribute("onValue").split(','),evt.getValue());}else{if(comp.hasAttribute("Inverted")){Text.setAttribute("Content",_getAnalogDisplayText(evt.getTarget().getFullBindName(),parseInt(comp.getAttribute("Inverted"))-parseFloat(evt.getValue()*EngScale),dec,units));}else{Text.setAttribute("Content",_getAnalogDisplayText(evt.getTarget().getFullBindName(),parseFloat(evt.getValue()*EngScale),dec,units));}var onW=Text.getBoundingBox().get_Width();var offW=0;}var bg=display.getChildByName("background");var maxW=Math.max(onW,offW,onW2,offW2);if(HorAlign=="l"){var nw=_roundUp(maxW,5);bg.setAttribute("Width",Math.max(oriWidth,nw)+5);comp.getChild("right").setAttribute("Left",origRightPos+8+(Math.max(0,(nw-oriWidth))));}if(HorAlign=="c"){var nw=_roundUp(maxW,5)+5;bg.setAttribute("Width",Math.max(oriWidth,nw));bg.setAttribute("Left",(-(Math.max(oriWidth,nw)-oriWidth)/2));comp.getChild("right").setAttribute("Left",origRightPos+3+(Math.max(0,(nw-oriWidth)/2)));comp.getChild("Alarm").setAttribute("Left",origLeftPos-3-(Math.max(0,(nw-oriWidth)/2)));}if(HorAlign=="r"){var nw=_roundUp(maxW,5);bg.setAttribute("Width",Math.max(oriWidth,nw)+5);bg.setAttribute("Left",Math.min(0,oriWidth-nw)-2.5);comp.getChild("right").setAttribute("Left",origRightPos+5);comp.getChild("Alarm").setAttribute("Left",bg.getAttribute("Left")-5);}}/*END 012*/}]]></Script>
        <Script Id="A013" Name="_getIcons" OnDocumentLoad="onFirstLoad"><![CDATA[function onFirstLoad(evt){/*START 013*/_getIcons=function(evt){var offset=0;var comp=evt.getCurrentTarget();if(comp.hasAttribute("double"))offset=10;var AlarmComp=comp.getChild("Alarm");var AlarmIconTemplate=comp.getOwnerDocument().getElementById("AlarmGroup").cloneNode(true);AlarmIconTemplate.setAttribute("Left",0);if(comp.hasAttribute("double")){AlarmIconTemplate.setAttribute("Top",3);}else{AlarmIconTemplate.setAttribute("Top",offset+2);}AlarmIconTemplate.getChild("AlarmComponent").setAttribute("Visibility","Hidden");AlarmComp.appendChild(AlarmIconTemplate);var ForceComp=comp.getChild("right");var ForceIconTemplate=comp.getOwnerDocument().getElementById("ForceGroup").cloneNode(true);ForceIconTemplate.setAttribute("Left",3);ForceIconTemplate.setAttribute("Top",offset+0);ForceIconTemplate.setAttribute("Visibility","Hidden");ForceComp.appendChild(ForceIconTemplate);var DatabaseIconTemplate=comp.getOwnerDocument().getElementById("DatabaseGroup").cloneNode(true);DatabaseIconTemplate.setAttribute("Left",3);DatabaseIconTemplate.setAttribute("Top",offset+0);DatabaseIconTemplate.setAttribute("Visibility","Hidden");ForceComp.appendChild(DatabaseIconTemplate);var NetworkIconTemplate=comp.getOwnerDocument().getElementById("NetworkGroup").cloneNode(true);NetworkIconTemplate.setAttribute("Left",3);NetworkIconTemplate.setAttribute("Top",offset+0);NetworkIconTemplate.setAttribute("Visibility","Hidden");ForceComp.appendChild(NetworkIconTemplate);var BacOvrIconTemplate=comp.getOwnerDocument().getElementById("BACOvrGroup").cloneNode(true);BacOvrIconTemplate.setAttribute("Left",9);BacOvrIconTemplate.setAttribute("Top",offset+2);BacOvrIconTemplate.setAttribute("Visibility","Hidden");ForceComp.appendChild(BacOvrIconTemplate);}/*END 013*/}]]></Script>
        <Script Id="A014" Name="_setAnalogueDamper" OnDocumentLoad="onFirstLoad"><![CDATA[function onFirstLoad(evt){/*START A014*/_setAnalogueDamper=function(evt){var comp=evt.getCurrentTarget();if(!comp.hasAttribute("Recuperator")){_onChange(evt);var rot=new Array();rot=comp.getElementsByTagName("Rotate");var rotLen=rot.length;try{var style=comp.getChild("style");var t=parseFloat(style.getAttribute("Max"));var b=parseFloat(style.getAttribute("Min"));var cClr=String(style.getAttribute("Fill"));var oClr=String(style.getAttribute("Stroke"));}catch(ex){}var v=parseFloat(comp.getAttribute("val1"));var tmp;if(t>b){if(v>=t)v=t;else{if(v<=b)v=b;}}else{if(v>=b)v=b;else{if(v<=t)v=t;}}tmp=v-b;tmp=tmp/(t-b);tmp=tmp*100;tmp=tmp*.9;for(var i=0;i<rotLen;i++){if(comp.hasAttribute("Parallel")){rot.item(i).setAttribute("Angle",90-(0-tmp));}else{if(i%2==0){rot.item(i).setAttribute("Angle",90-(0-tmp));}else{rot.item(i).setAttribute("Angle",90-tmp);}}}if(v>=b&&v<=t){try{comp.getChildRecursive("GS").setAttribute("Color",_colourFinder(cClr,oClr,b,t,v));}catch(ex){}}else if(v<=b&&v>=t){try{comp.getChildRecursive("GS").setAttribute("Color",_colourFinder(oClr,cClr,t,b,v));}catch(ex){}}_decideStatus(evt);}else{var Reccomp=comp.getChild("Recuperator");var bindId=Number(1);if(parseInt(evt.getTarget().getAttribute("Id"))==2){bindId=2;}switch(String(evt.getTarget().getAttribute("Description"))){case"Value":Reccomp.setAttribute("val"+bindId,evt.getValue());Reccomp.setAttribute("stat"+bindId,parseInt(evt.getStatus()));break;case"OverrideState":Reccomp.setAttribute("OverrideState"+bindId,String(evt.getValue()).toLowerCase());break;case"OutOfService":Reccomp.setAttribute("OutOfService"+bindId,String(evt.getValue()).toLowerCase());break;case"ActiveCommandPriority":Reccomp.setAttribute("ActiveCommandPriority"+bindId,parseInt(evt.getValue()));break;case"ForcedByOperator":Reccomp.setAttribute("ForcedByOperator"+bindId,evt.getValue());break;case"Reliability":Reccomp.setAttribute("Reliability"+bindId,parseInt(evt.getValue()));break;case"AlarmState":Reccomp.setAttribute("AlarmState"+bindId,parseInt(evt.getValue()));break;}var rot=new Array();rot=Reccomp.getElementsByTagName("Rotate");var rotLen=rot.length;try{var style=Reccomp.getChild("style");var t=parseFloat(style.getAttribute("Max"));var b=parseFloat(style.getAttribute("Min"));var cClr=String(style.getAttribute("Fill"));var oClr=String(style.getAttribute("Stroke"));}catch(ex){}var v=parseFloat(Reccomp.getAttribute("val1"));var tmp;if(t>b){if(v>=t)v=t;else{if(v<=b)v=b;}}else{if(v>=b)v=b;else{if(v<=t)v=t;}}tmp=v-b;tmp=tmp/(t-b);tmp=tmp*100;tmp=tmp*.9;for(var i=0;i<rotLen;i++){if(Reccomp.hasAttribute("Parallel")){rot.item(i).setAttribute("Angle",90-(0-tmp));}else{if(i%2==0){rot.item(i).setAttribute("Angle",90-(0-tmp));}else{rot.item(i).setAttribute("Angle",90-tmp);}}}if(v>=b&&v<=t){try{Reccomp.getChildRecursive("GS").setAttribute("Color",_colourFinder(cClr,oClr,b,t,v));}catch(ex){}}else if(v<=b&&v>=t){try{Reccomp.getChildRecursive("GS").setAttribute("Color",_colourFinder(oClr,cClr,t,b,v));}catch(ex){}}_recupStatus(comp.getChild("Recuperator"));comp=comp.getChild("Bypass");var bindId=Number(1);if(parseInt(evt.getTarget().getAttribute("Id"))==2){bindId=2;}switch(String(evt.getTarget().getAttribute("Description"))){case"Value":comp.setAttribute("val"+bindId,evt.getValue());comp.setAttribute("stat"+bindId,parseInt(evt.getStatus()));break;case"OverrideState":comp.setAttribute("OverrideState"+bindId,String(evt.getValue()).toLowerCase());break;case"OutOfService":comp.setAttribute("OutOfService"+bindId,String(evt.getValue()).toLowerCase());break;case"ActiveCommandPriority":comp.setAttribute("ActiveCommandPriority"+bindId,parseInt(evt.getValue()));break;case"ForcedByOperator":comp.setAttribute("ForcedByOperator"+bindId,evt.getValue());break;case"Reliability":comp.setAttribute("Reliability"+bindId,parseInt(evt.getValue()));break;case"AlarmState":comp.setAttribute("AlarmState"+bindId,parseInt(evt.getValue()));break;}var rot=new Array();rot=comp.getElementsByTagName("Rotate");var rotLen=rot.length;try{var style=comp.getChild("style");var t=parseFloat(style.getAttribute("Max"));var b=parseFloat(style.getAttribute("Min"));var cClr=String(style.getAttribute("Fill"));var oClr=String(style.getAttribute("Stroke"));}catch(ex){}var v=parseFloat(comp.getAttribute("val1"));var tmp;if(t>b){if(v>=t)v=t;else{if(v<=b)v=b;}}else{if(v>=b)v=b;else{if(v<=t)v=t;}}tmp=v-b;tmp=tmp/(t-b);tmp=tmp*100;tmp=tmp*.9;for(var i=0;i<rotLen;i++){if(comp.hasAttribute("Parallel")){rot.item(i).setAttribute("Angle",90-(0-tmp));}else{if(i%2==0){rot.item(i).setAttribute("Angle",90-(0-tmp));}else{rot.item(i).setAttribute("Angle",90-tmp);}}}if(v>=b&&v<=t){try{comp.getChildRecursive("GS").setAttribute("Color",_colourFinder(cClr,oClr,b,t,v));}catch(ex){}}else if(v<=b&&v>=t){try{comp.getChildRecursive("GS").setAttribute("Color",_colourFinder(oClr,cClr,t,b,v));}catch(ex){}}_recupStatus(comp);}}/*END A014*/}]]></Script>
        <Script Id="A015" Name="_setDigitalDamper" OnDocumentLoad="onFirstLoad"><![CDATA[function onFirstLoad(evt){/*START 015*/_setDigitalDamper=function(evt){_onChange(evt);var comp=evt.getCurrentTarget();var dispOpen=comp.getChild("Open");var dispClosed=comp.getChild("Closed");var onValue=comp.getAttribute("onValue").split(',');try{var style=comp.getChild("style");var cClr=String(style.getAttribute("Stroke"));var oClr=String(style.getAttribute("Fill"));}catch(ex){}var val=comp.getAttribute("val1");if(_Bool(onValue,val)){dispOpen.setAttribute("Visibility","Visible");dispClosed.setAttribute("Visibility","Hidden");try{comp.getChildRecursive("GS").setAttribute("Color",oClr);}catch(ex){}}else{dispOpen.setAttribute("Visibility","Hidden");dispClosed.setAttribute("Visibility","Visible");try{comp.getChildRecursive("GS").setAttribute("Color",cClr);}catch(ex){}}_decideStatus(evt);}/*END 015*/}]]></Script>
        <Script Id="A016" Name="_colourFinder" OnDocumentLoad="onFirstLoad"><![CDATA[function onFirstLoad(evt){/*START 016*/_colourFinder=function(onClr,offClr,minVal,maxVal,val){if(offClr.slice(0,1)=="#"){if(String(offClr.length)==7)offClr=offClr.slice(-6);if(String(offClr.length)==9)offClr=offClr.slice(-8);}if(onClr.slice(0,1)=="#"){if(String(onClr.length)==7)onClr=onClr.slice(-6);if(String(onClr.length)==9)onClr=onClr.slice(-8);}if(maxVal<minVal){if(val<maxVal)val=maxVal;if(val>minVal)val=minVal;var eRe=parseInt(offClr.slice(0,2),16);var eGr=parseInt(offClr.slice(2,4),16);var eBl=parseInt(offClr.slice(-2),16);var sRe=parseInt(onClr.slice(0,2),16);var sGr=parseInt(onClr.slice(2,4),16);var sBl=parseInt(onClr.slice(-2),16);}else{if(val>maxVal)val=maxVal;if(val<minVal)val=minVal;var sRe=parseInt(offClr.slice(0,2),16);var sGr=parseInt(offClr.slice(2,4),16);var sBl=parseInt(offClr.slice(-2),16);var eRe=parseInt(onClr.slice(0,2),16);var eGr=parseInt(onClr.slice(2,4),16);var eBl=parseInt(onClr.slice(-2),16);}var percenta=0.01*((val-minVal)*100)/(maxVal-minVal);var returnRe=("0"+parseInt(sRe+((eRe-sRe)*percenta)).toString(16)).slice(-2).toUpperCase();var returnGr=("0"+parseInt(sGr+((eGr-sGr)*percenta)).toString(16)).slice(-2).toUpperCase();var returnBl=("0"+parseInt(sBl+((eBl-sBl)*percenta)).toString(16)).slice(-2).toUpperCase();return("#"+returnRe+""+returnGr+""+returnBl);}/*END 016*/}]]></Script>
        <Script Id="A017" Name="_setFlow" OnDocumentLoad="onFirstLoad"><![CDATA[function onFirstLoad(evt){/*START 017*/_setFlow=function(evt){_onChange(evt);var comp=evt.getCurrentTarget();var ani=new Array();ani=comp.getElementsByTagName("Animate");var animateReq="Stop";if(_Bool(comp.getAttribute("onValue").split(','),comp.getAttribute("val1"))){animateReq="Start";}var aniLen=ani.length;for(var i=0;i<aniLen;i++){ani.item(i).setAttribute("Animation",animateReq);}_decideStatus(evt);}/*END 017*/}]]></Script>
        <Script Id="A018" Name="_setFans (Digital)" OnDocumentLoad="onFirstLoad"><![CDATA[function onFirstLoad(evt){/*START 018*/_setFans=function(evt){var comp=evt.getCurrentTarget();if(!comp.hasAttribute("initialised")){comp.setAttribute("val1",0);comp.setAttribute("stat1",2);comp.setAttribute("val2",0);comp.setAttribute("stat2",2);comp.setAttribute("OverrideState1",false);comp.setAttribute("OverrideState2",false);comp.setAttribute("ActiveCommandPriority1",16);comp.setAttribute("ActiveCommandPriority2",16);comp.setAttribute("OutOfService1",false);comp.setAttribute("OutOfService2",false);comp.setAttribute("initialised","")}_onChange(evt);try{if(String(comp.getAttribute("Fill"))!="None"){var onColour=comp.getAttribute("Fill");var offColour=comp.getAttribute("Stroke");}else{var onColour="#4FA600";var offColour="#C6C9CD";}}catch(ex){}var anima="Stop";var reqColour=offColour;try{if(_Bool(comp.getAttribute("onValue").split(','),comp.getAttribute("val1"))){reqColour=onColour;comp.getChildRecursive("1").setAttribute("Fill",onColour);anima="Start";}else{comp.getChildRecursive("1").setAttribute("Fill",offColour);}}catch(ex){}try{if(_Bool(comp.getAttribute("onValue").split(','),comp.getAttribute("val2"))){reqColour=onColour;comp.getChildRecursive("2").setAttribute("Fill",onColour);anima="Start";}else{comp.getChildRecursive("2").setAttribute("Fill",offColour);}}catch(ex){}var animList=comp.getElementsByTagName("Animate");var aniL=animList.length;for(var i=0;i<aniL;i++){animList.item(i).setAttribute("Animation",anima);}var body=comp.getElementsByTagName("*");var bodLen=body.length;for(var i=0;i<bodLen;i++){if(body.item(i).getAttribute("Name")=="Base")body.item(i).setAttribute("Fill",reqColour);if(body.item(i).hasAttribute("strokeChange")){body.item(i).setAttribute("Stroke",reqColour);}}try{comp.getChildRecursive("FanBody").setAttribute("Color",reqColour);}catch(ex){}try{if(_Bool(comp.getAttribute("onValue").split(','),String(comp.getAttribute("val1")))){comp.getChildRecursive("cover1").setAttribute("Visibility","Hidden");}else{comp.getChildRecursive("cover1").setAttribute("Visibility","Visible");}}catch(ex){}try{if(_Bool(comp.getAttribute("onValue").split(','),String(comp.getAttribute("val2")))){comp.getChildRecursive("cover2").setAttribute("Visibility","Hidden");}else{comp.getChildRecursive("cover2").setAttribute("Visibility","Visible");}}catch(ex){}_fanStatus(evt);}/*END 018*/}]]></Script>
        <Script Id="A019" Name="_setAnalogueFans" OnDocumentLoad="onFirstLoad"><![CDATA[function onFirstLoad(evt){/*START 019*/_setAnalogueFans=function(evt){var comp=evt.getCurrentTarget();if(!comp.hasAttribute("initialised")){comp.setAttribute("val1",0);comp.setAttribute("stat1",2);comp.setAttribute("val2",0);comp.setAttribute("stat2",2);comp.setAttribute("OverrideState1",false);comp.setAttribute("OverrideState2",false);comp.setAttribute("ActiveCommandPriority1",16);comp.setAttribute("ActiveCommandPriority2",16);comp.setAttribute("OutOfService1",false);comp.setAttribute("OutOfService2",false);comp.setAttribute("initialised","")}_onChange(evt);var comp=evt.getCurrentTarget();try{if(String(comp.getAttribute("Fill"))!="None"){var onColour=comp.getAttribute("Fill");var offColour=comp.getAttribute("Stroke");}else{var onColour="#4FA600";var offColour="#C6C9CD";}}catch(ex){}var anima="Stop";var reqColour=offColour;try{if(parseFloat(comp.getAttribute("val1"))>parseFloat(comp.getAttribute("onValue"))){comp.getChildRecursive("1").setAttribute("Fill",onColour);anima="Start";}else{comp.getChildRecursive("1").setAttribute("Fill",offColour);}}catch(ex){}try{if(parseFloat(comp.getAttribute("val2"))>parseFloat(comp.getAttribute("onValue"))){comp.getChildRecursive("2").setAttribute("Fill",onColour);anima="Start";}else{comp.getChildRecursive("2").setAttribute("Fill",offColour);}}catch(ex){}if(anima=="Start")reqColour=onColour;var animList=comp.getElementsByTagName("Animate");var aniL=animList.length;for(var i=0;i<aniL;i++){animList.item(i).setAttribute("Animation",anima);}var body=comp.getElementsByTagName("*");var bodLen=body.length;for(var i=0;i<bodLen;i++){if(body.item(i).getAttribute("Name")=="Base")body.item(i).setAttribute("Fill",reqColour);if(body.item(i).hasAttribute("strokeChange")){body.item(i).setAttribute("Stroke",reqColour);}}try{comp.getChildRecursive("FanBody").setAttribute("Color",reqColour);}catch(ex){}try{if(parseFloat(comp.getAttribute("val1"))>comp.getAttribute("onValue")){comp.getChildRecursive("cover1").setAttribute("Visibility","Hidden");}else{comp.getChildRecursive("cover1").setAttribute("Visibility","Visible");}}catch(ex){}try{if(parseFloat(comp.getAttribute("val2"))>comp.getAttribute("onValue")){comp.getChildRecursive("cover2").setAttribute("Visibility","Hidden");}else{comp.getChildRecursive("cover2").setAttribute("Visibility","Visible");}}catch(ex){}_fanStatus(evt);}/*END 019*/}]]></Script>
        <Script Id="A020" Name="_setHumidifier" OnDocumentLoad="onFirstLoad"><![CDATA[function onFirstLoad(evt){/*START 020*/_setHumidifier=function(evt){_onChange(evt);var comp=evt.getCurrentTarget();var onValue=comp.getAttribute("onValue").split(',');var body=comp.getChildByName("Bg");var offColour=body.getAttribute("Fill");var spray=comp.getChildByName("SprayGrp");var onColour=evt.getCurrentTarget().getAttribute("Fill");var scaleFactor;var tos;var bos;var sprayArr=[];if(comp.hasAttribute("TopOfScale")){sprayArr=comp.getElementsByTagName("RadialGradient");tos=parseFloat(comp.getAttribute("TopOfScale"));bos=parseFloat(comp.getAttribute("BottomOfScale"));scaleFactor=tos-bos;var val=parseFloat(comp.getAttribute("val1"));if(isNaN(val))val=0;if(val>tos)val=tos;if(val<=bos){val=bos;body.setAttribute("Color",offColour);}else{body.setAttribute("Color",onColour);}var tmpLen=sprayArr.length;var radius="RadiusX";if(comp.hasAttribute("horizontal"))radius="RadiusY";for(var i=0;tmpLen>i;i++){if(val<=0){sprayArr.item(i).setAttribute(radius,0.001);}else{sprayArr.item(i).setAttribute(radius,((100/scaleFactor)*(val-bos))/100);}}}else{if(_Bool(onValue,comp.getAttribute("val1"))){spray.setAttribute("Visibility","Visible");body.setAttribute("Color",onColour);}else{spray.setAttribute("Visibility","Hidden");body.setAttribute("Color",offColour);}}_decideStatus(evt);}/*END 020*/}]]></Script>
        <Script Id="A021" Name="_setThermalWheel" OnDocumentLoad="onFirstLoad"><![CDATA[function onFirstLoad(evt){/*START 021*/_setThermalWheel=function(evt){_onChange(evt);var comp=evt.getCurrentTarget();var anims=comp.getElementsByTagName("Animate");var AL=anims.length;var onColour=comp.getAttribute("Fill");var offColour=comp.getAttribute("Stroke");var bndDesc=evt.getTarget().getAttribute("Description");if(bndDesc=="FbkValue"){var result=false;if(evt.getTarget().hasAttribute("onValue"))result=_Bool(evt.getTarget().getAttribute("onValue").split(','),comp.getAttribute("Fbkval"));if(evt.getTarget().hasAttribute("analogue"))result=parseFloat(comp.getAttribute("Fbkval"))>0;if(result){var cmd="Start";comp.getChildRecursive("FbkColor1").setAttribute("Color",onColour);comp.getChildRecursive("FbkColor2").setAttribute("Color",onColour);}else{var cmd="Stop";comp.getChildRecursive("FbkColor1").setAttribute("Color",offColour);comp.getChildRecursive("FbkColor2").setAttribute("Color",offColour);}for(var i=0;i<AL;i++){if(anims.item(i).hasAttribute("motor")){}else{anims.item(i).setAttribute("Animation",cmd);}}}if(bndDesc=="CmdValue"){var result=false;if(evt.getTarget().hasAttribute("onValue"))result=_Bool(evt.getTarget().getAttribute("onValue").split(','),comp.getAttribute("Cmdval"));if(evt.getTarget().hasAttribute("analogue"))result=parseFloat(comp.getAttribute("Cmdval"))>0;if(result){var cmd="Start";comp.getChildRecursive("Cmd1").setAttribute("Fill",onColour);comp.getChildRecursive("Cmd2").setAttribute("Fill",onColour);}else{var cmd="Stop";comp.getChildRecursive("Cmd1").setAttribute("Fill",offColour);comp.getChildRecursive("Cmd2").setAttribute("Fill",offColour);}for(var i=0;i<AL;i++){if(anims.item(i).hasAttribute("motor")){anims.item(i).setAttribute("Animation",cmd);}else{}}}_decideStatus(evt);}/*END 021*/}]]></Script>
        <Script Id="A022" Name="_setChillers" OnDocumentLoad="onfirstLoad"><![CDATA[function onfirstLoad(evt){/*START 022*/_setChillers=function(evt){_onChange(evt);var comp=evt.getCurrentTarget();var onColour=comp.getAttribute("Fill");var offColour=comp.getAttribute("Stroke");var Fans=comp.getChildRecursive("Fans");var val=String(comp.getAttribute("val"));if(evt.getTarget().hasAttribute("tower")){if(_Bool(comp.getAttribute("onValue").split(','),String(val))){_finder(comp,"Animate","Animation","Start",true);_finder(comp,"Curve","Fill",onColour,"skip");_finder(comp,"Path","Fill",onColour,"skip");}else{_finder(comp,"Animate","Animation","Stop",true);_finder(comp,"Curve","Fill",offColour,"skip");_finder(comp,"Path","Fill",offColour,"skip");}}if(evt.getTarget().hasAttribute("compressor")){var colour=offColour;if(_Bool(evt.getTarget().getAttribute("onValue").split(','),String(val)))colour=onColour;comp.getChildRecursive(String(evt.getTarget().getAttribute("compressor"))).setAttribute("Fill",colour);}if(evt.getTarget().hasAttribute("chiller")){if(_Bool(evt.getTarget().getAttribute("onValue").split(','),String(val))){_checkAnim(Fans,"Animate","Animation","Start",true);_checkAnim(Fans,"Curve","Fill",onColour,true);}else{_checkAnim(Fans,"Animate","Animation","Stop",true);_checkAnim(Fans,"Curve","Fill",offColour,true);}}if(String(comp.getAttribute("OverrideState"))=="true"||String(comp.getAttribute("OverrideState"))==true){if(evt.getTarget().hasAttribute("chiller")||evt.getTarget().hasAttribute("tower")){_stateSet(evt,"ovr","ct");}else{_stateSet(evt,"ovr",String(evt.getTarget().getAttribute("compressor")));}}else{if(evt.getTarget().hasAttribute("chiller")||evt.getTarget().hasAttribute("tower")){_stateSet(evt,"norm","ct");}else{_stateSet(evt,"norm",String(evt.getTarget().getAttribute("compressor")));}}}/*END 022*/}]]></Script>
        <Script Id="A023" Name="_sensors" OnDocumentLoad="onFirstLoad"><![CDATA[function onFirstLoad(evt){/*START 023*/_sensors=function(evt){_onChange(evt);var comp=evt.getCurrentTarget();var body=comp.getChildByName("background");var text=comp.getChildByName("text");var offColour=body.getAttribute("Fill");var onColour=body.getAttribute("Stroke");if(_Bool(comp.getAttribute("onValue").split(','),comp.getAttribute("val1"))){body.setAttribute("Fill",comp.getAttribute("Stroke"));text.setAttribute("Stroke","#FFFFFF");}else{body.setAttribute("Fill",comp.getAttribute("Fill"));text.setAttribute("Stroke","#333333");}_decideStatus(evt);}/*END 023*/}]]></Script>
        <Script Id="A024" Name="_setValves (Analogue)" OnDocumentLoad="onFirstLoad"><![CDATA[function onFirstLoad(evt){/*START 024*/_setValves=function(evt){_onChange(evt);var comp=evt.getCurrentTarget();var style=comp.getChild("style");var t=parseFloat(style.getAttribute("Max"));var b=parseFloat(style.getAttribute("Min"));var cClr=String(style.getAttribute("Fill"));var oClr=String(style.getAttribute("Stroke"));var v=parseFloat(evt.getValue());var tmp;if(t>b){if(v>=t)v=t;else{if(v<=b)v=b;}}else{if(v>=b)v=b;else{if(v<=t)v=t;}}if(v>b&&v<t){try{comp.getChild("body").setAttribute("Fill",_colourFinder(cClr,oClr,b,t,v));comp.getChild("body").setAttribute("Stroke",_colourFinder(cClr,oClr,b,t,v));}catch(ex){}}if(v<=b){try{comp.getChild("body").setAttribute("Fill",oClr);comp.getChild("body").setAttribute("Stroke",oClr);}catch(ex){}}if(v>=t){try{comp.getChild("body").setAttribute("Fill",cClr);comp.getChild("body").setAttribute("Stroke",cClr);}catch(ex){}}_decideStatus(evt);}/*END 024*/}]]></Script>
        <Script Id="A025" Name="_getStatus" OnDocumentLoad="onFirstLoad"><![CDATA[function onFirstLoad(evt){/*START 025*/_getStatus=function(evt,id){if(id===undefined){switch(parseInt(evt.getStatus())){case 1:var str="#42B4E6";var sw=2;break;case 0:var str="#FF6000";var sw=2;break;case 3:var str="#FFD100";var sw=2;break;default:var str="Original";var sw=1;}}else{switch(parseInt(id)){case 1:var str="#42B4E6";var sw=2;break;case 0:var str="#FF6000";var sw=2;break;case 3:var str="#FFD100";var sw=2;break;default:var str="Original";var sw=1;}}var theArray=new Array();theArray.push(str,sw);return(theArray);}/*END 025*/}]]></Script>
        <Script Id="A026" Name="_setStatus" OnDocumentLoad=""><![CDATA[function onFirstLoad(evt){/*START 026*/_setStatus=function(evt){comp=evt.getCurrentTarget();var str=String(_getStatus(evt)[0]);var sw=Number(_getStatus(evt)[1]);try{if(!comp.hasAttribute("obackgroundcolour"))comp.setAttribute("obackgroundcolour",comp.getChildRecursive("background").getAttribute("Stroke"));comp.getChildRecursive("background").setAttribute("Stroke",(str=="Original")?comp.getAttribute("obackgroundcolour"):str);comp.getChildRecursive("background").setAttribute("StrokeWidth",sw);}catch(ex){}try{if(!comp.hasAttribute("obackground1colour"))comp.setAttribute("obackground1colour",comp.getChildRecursive("background1").getAttribute("Stroke"));comp.getChildRecursive("background1").setAttribute("Stroke",(str=="Original")?comp.getAttribute("obackground1colour"):str);comp.getChildRecursive("background1").setAttribute("StrokeWidth",sw);}catch(ex){}try{if(!comp.hasAttribute("obackground2colour"))comp.setAttribute("obackground2colour",comp.getChildRecursive("background1").getAttribute("Stroke"));comp.getChildRecursive("background2").setAttribute("Stroke",(str=="Original")?comp.getAttribute("obackground2colour"):str);comp.getChildRecursive("background2").setAttribute("StrokeWidth",sw);}catch(ex){}try{if(!comp.hasAttribute("obackground3colour"))comp.setAttribute("obackground3colour",comp.getChildRecursive("background3").getAttribute("Stroke"));comp.getChildRecursive("background3").setAttribute("Stroke",(str=="Original")?comp.getAttribute("obackground3colour"):str);comp.getChildRecursive("background3").setAttribute("StrokeWidth",sw);}catch(ex){}}/*END 026*/}]]></Script>
        <Script Id="A027" Name="_setTanks" OnDocumentLoad="onFirstLoad"><![CDATA[function onFirstLoad(evt){/*START 027*/_setTanks=function(evt){_onChange(evt);if(evt.getTarget().getAttribute("Id")==2){_setTankLevels(evt,2);}else{_setTankLevels(evt,1);}}/*END 027*/}]]></Script>
        <Script Id="A028" Name="_setDigitalValves" OnDocumentLoad="onFirstLoad"><![CDATA[function onFirstLoad(evt){/*START 028*/_setDigitalValves=function(evt){_onChange(evt);var comp=evt.getCurrentTarget();var style=comp.getChild("style");var oClr=String(style.getAttribute("Fill"));var cClr=String(style.getAttribute("Stroke"));if(comp.hasAttribute("dig3port")){if(_Bool(style.getAttribute("onValue").split(','),String(comp.getAttribute("val1")))){comp.getChildByName("1").setAttribute("Visibility","Visible");comp.getChildByName("2").setAttribute("Visibility","Hidden");}else{comp.getChildByName("1").setAttribute("Visibility","Hidden");comp.getChildByName("2").setAttribute("Visibility","Visible");}}else{var clr=cClr;if(_Bool(style.getAttribute("onValue").split(','),String(comp.getAttribute("val1")))){clr=oClr;}try{comp.getChild("body").setAttribute("Fill",clr);comp.getChild("body").setAttribute("Stroke",clr);}catch(ex){}}_decideStatus(evt);}/*END 028*/}]]></Script>
        <Script Id="A029" Name="_decideStatus" OnDocumentLoad="onFirstLoad"><![CDATA[function onFirstLoad(evt){/*START 029*/_decideStatus=function(evt){var comp=evt.getCurrentTarget();if(comp.hasAttribute("tank")){var levelArray1=new Array();var levelArray2=new Array();if(comp.hasAttribute("HighHighLevelstat1"))levelArray1.push(comp.getAttribute("HighHighLevelstat1"));if(comp.hasAttribute("HighHighLevelstat2"))levelArray2.push(comp.getAttribute("HighHighLevelstat2"));if(comp.hasAttribute("HighLevelstat1"))levelArray1.push(comp.getAttribute("HighLevelstat1"));if(comp.hasAttribute("HighLevelstat2"))levelArray2.push(comp.getAttribute("HighLevelstat2"));if(comp.hasAttribute("LowLevelstat1"))levelArray1.push(comp.getAttribute("LowLevelstat1"));if(comp.hasAttribute("LowLevelstat2"))levelArray2.push(comp.getAttribute("LowLevelstat2"));if(comp.hasAttribute("LowLowLevelstat1"))levelArray1.push(comp.getAttribute("LowLowLevelstat1"));if(comp.hasAttribute("LowLowLevelstat2"))levelArray2.push(comp.getAttribute("LowLowLevelstat2"));if(comp.hasAttribute("stat1"))levelArray1.push(comp.getAttribute("stat1"));if(comp.hasAttribute("stat2"))levelArray2.push(comp.getAttribute("stat2"));var curVal1=2;var curVal2=2;if(levelArray1.length>0){for(var i=0;i<levelArray1.length;i++){if(levelArray1[i]==3){curVal1=levelArray1[i];break;}else if(levelArray1[i]==0&&curVal1!=3){curVal1=levelArray1[i];}else if(levelArray1[i]==1&&curVal1!=3&&curVal1!=0){curVal1=levelArray1[i];}}var str=_getStatus(evt,curVal1)[0];var sw=_getStatus(evt,curVal1)[1];try{if(!comp.hasAttribute("otank1Statcolour"))comp.setAttribute("otank1Statcolour",comp.getChildRecursive("tank1Stat").getAttribute("Stroke"));comp.getChildRecursive("tank1Stat").setAttribute("Stroke",(str=="Original")?comp.getAttribute("otank1Statcolour"):str);comp.getChildRecursive("tank1Stat").setAttribute("StrokeWidth",sw);}catch(ex){}}if(levelArray2.length>0){for(var i=0;i<levelArray2.length;i++){if(levelArray2[i]==3){curVal2=levelArray2[i];break;}else if(levelArray2[i]==0&&curVal2!=3){curVal2=levelArray2[i];}else if(levelArray2[i]==1&&curVal2!=3&&curVal2!=0){curVal2=levelArray2[i];}}var str=_getStatus(evt,curVal2)[0];var sw=_getStatus(evt,curVal2)[1];try{if(!comp.hasAttribute("otank2Statcolour"))comp.setAttribute("otank2Statcolour",comp.getChildRecursive("tank2Stat").getAttribute("Stroke"));comp.getChildRecursive("tank2Stat").setAttribute("Stroke",(str=="Original")?comp.getAttribute("otank2Statcolour"):str);comp.getChildRecursive("tank2Stat").setAttribute("StrokeWidth",sw);}catch(ex){}}}else{if(String(comp.getAttribute("OverrideState1"))=="true"||String(comp.getAttribute("OverrideState1"))==true||String(comp.getAttribute("Reliability1"))=="true"||String(comp.getAttribute("Reliability1"))==true){var str="#F0080E";var sw=2;}else{if(comp.getAttribute("OutOfService1")=="true"||parseInt(comp.getAttribute("ActiveCommandPriority1"))<=8||comp.getAttribute("ForcedByOperator1")==1||parseInt(comp.getAttribute("ForcedByOperator1"))==2){var str=_getStatus(evt,3)[0];var sw=_getStatus(evt,3)[1];}else{var str=_getStatus(evt,comp.getAttribute("stat1"))[0];var sw=_getStatus(evt,comp.getAttribute("stat1"))[1];}}try{if(!comp.hasAttribute("obackgroundcolour"))comp.setAttribute("obackgroundcolour",comp.getChildRecursive("background").getAttribute("Stroke"));comp.getChildRecursive("background").setAttribute("Stroke",(str=="Original")?comp.getAttribute("obackgroundcolour"):str);comp.getChildRecursive("background").setAttribute("StrokeWidth",sw);}catch(ex){}try{if(!comp.hasAttribute("obackground1colour"))comp.setAttribute("obackground1colour",comp.getChildRecursive("background1").getAttribute("Stroke"));comp.getChildRecursive("background1").setAttribute("Stroke",(str=="Original")?comp.getAttribute("obackground1colour"):str);comp.getChildRecursive("background1").setAttribute("StrokeWidth",sw);}catch(ex){}try{if(!comp.hasAttribute("obackground2colour"))comp.setAttribute("obackground2colour",comp.getChildRecursive("background2").getAttribute("Stroke"));comp.getChildRecursive("background2").setAttribute("Stroke",(str=="Original")?comp.getAttribute("obackground2colour"):str);comp.getChildRecursive("background2").setAttribute("StrokeWidth",sw);}catch(ex){}try{if(!comp.hasAttribute("obackground3colour"))comp.setAttribute("obackground3colour",comp.getChildRecursive("background3").getAttribute("Stroke"));comp.getChildRecursive("background3").setAttribute("Stroke",(str=="Original")?comp.getAttribute("obackground3colour"):str);comp.getChildRecursive("background3").setAttribute("StrokeWidth",sw);}catch(ex){}if(String(comp.getAttribute("FbkOverrideState"))=="true"||String(comp.getAttribute("FbkOverrideState"))==true){var str="#F0080E";var sw=2;}else{if(comp.getAttribute("FbkOutOfService")=="true"||parseInt(comp.getAttribute("FbkActiveCommandPriority"))<=8){var str=_getStatus(evt,3)[0];var sw=_getStatus(evt,3)[1];}else{var str=_getStatus(evt,comp.getAttribute("Fbkstat"))[0];var sw=_getStatus(evt,comp.getAttribute("Fbkstat"))[1];}}try{if(!comp.hasAttribute("obackgroundFbkcolour"))comp.setAttribute("obackgroundFbkcolour",comp.getChildRecursive("backgroundFbk").getAttribute("Stroke"));comp.getChildRecursive("backgroundFbk").setAttribute("Stroke",(str=="Original")?comp.getAttribute("obackgroundFbkcolour"):str);comp.getChildRecursive("backgroundFbk").setAttribute("StrokeWidth",sw);}catch(ex){}if(String(comp.getAttribute("CmdOverrideState"))=="true"||String(comp.getAttribute("CmdOverrideState"))==true){var str="#F0080E";var sw=2;}else{if(comp.getAttribute("CmdOutOfService")=="true"||parseInt(comp.getAttribute("CmdActiveCommandPriority"))<=8){var str=_getStatus(evt,3)[0];var sw=_getStatus(evt,3)[1];}else{var str=_getStatus(evt,comp.getAttribute("Cmdstat"))[0];var sw=_getStatus(evt,comp.getAttribute("Cmdstat"))[1];}}try{if(!comp.hasAttribute("obackgroundCmdcolour"))comp.setAttribute("obackgroundCmdcolour",comp.getChildRecursive("backgroundCmd").getAttribute("Stroke"));comp.getChildRecursive("backgroundCmd").setAttribute("Stroke",(str=="Original")?comp.getAttribute("obackgroundCmdcolour"):str);comp.getChildRecursive("backgroundCmd").setAttribute("StrokeWidth",sw);}catch(ex){}}}/*END 029*/}]]></Script>
        <Script Id="A030" Name="_Animate" OnDocumentLoad="onFirstLoad"><![CDATA[function onFirstLoad(evt){/*START 030*/_Animate=function(evt,val){var bindList=evt.getCurrentTarget().getElementsByTagName("Animate");var len=bindList.length;for(var i=0;i<len;i++){bindList.item(i).setAttribute("Animation",val);}}/*END 030*/}]]></Script>
        <Script Id="A031" Name="_setFilter" OnDocumentLoad="onFirstLoad"><![CDATA[function onFirstLoad(evt){/*START 031*/_setFilter=function(evt){_onChange(evt);var comp=evt.getCurrentTarget();if(_Bool(comp.getAttribute("onValue").split(','),String(comp.getAttribute("val1")))){try{comp.getChildRecursive("GS").setAttribute("Color","#F0080E");comp.getChild("DP").setAttribute("Fill","#F0080E");}catch(ex){}}else{try{comp.getChildRecursive("GS").setAttribute("Color","#4FA600");comp.getChild("DP").setAttribute("Fill","#009530");}catch(ex){}}_decideStatus(evt);}/*END 031*/}]]></Script>
        <Script Id="A032" Name="_fanStatus" OnDocumentLoad="onFirstLoad"><![CDATA[function onFirstLoad(evt){/*START 032*/_fanStatus=function(evt){var comp=evt.getCurrentTarget();if(String(comp.getAttribute("OverrideState1"))=="true"||String(comp.getAttribute("OverrideState1"))==true||String(comp.getAttribute("Reliability1"))=="true"||String(comp.getAttribute("Reliability1"))==true){var str="#F0080E";var sw=2;}else if(String(comp.getAttribute("OutOfService1"))=="true"||parseInt(comp.getAttribute("ActiveCommandPriority1"))<=8||parseInt(comp.getAttribute("ForcedByOperator1"))==1||parseInt(comp.getAttribute("ForcedByOperator1"))==2){var str=_getStatus(evt,3)[0];var sw=_getStatus(evt,3)[1];}else{var str=_getStatus(evt,parseInt(comp.getAttribute("stat1")))[0];var sw=_getStatus(evt,parseInt(comp.getAttribute("stat1")))[1];}try{if(!comp.hasAttribute("oClr1")){comp.setAttribute("oClr1",comp.getChildRecursive("1").getAttribute("Stroke"));}comp.getChildRecursive("1").setAttribute("Stroke",(str=="Original")?comp.getAttribute("oClr1"):str);comp.getChildRecursive("1").setAttribute("StrokeWidth",sw);}catch(ex){}if(String(comp.getAttribute("OverrideState2"))=="true"||String(comp.getAttribute("OverrideState2"))==true||String(comp.getAttribute("Reliability2"))=="true"||String(comp.getAttribute("Reliability2"))==true){var str="#F0080E";var sw=2;}else if(String(comp.getAttribute("OutOfService2"))=="true"||parseInt(comp.getAttribute("ActiveCommandPriority2"))<=8||parseInt(comp.getAttribute("ForcedByOperator2"))==1||parseInt(comp.getAttribute("ForcedByOperator2"))==2){var str=_getStatus(evt,3)[0];var sw=_getStatus(evt,3)[1];}else{var str=_getStatus(evt,parseInt(comp.getAttribute("stat2")))[0];var sw=_getStatus(evt,parseInt(comp.getAttribute("stat2")))[1];}try{if(!comp.hasAttribute("oClr2")){comp.setAttribute("oClr2",comp.getChildRecursive("2").getAttribute("Stroke"));}comp.getChildRecursive("2").setAttribute("Stroke",(str=="Original")?comp.getAttribute("oClr2"):str);comp.getChildRecursive("2").setAttribute("StrokeWidth",sw);}catch(ex){}if(String(comp.getAttribute("OverrideState1"))=="true"||String(comp.getAttribute("OverrideState2"))=="true"||String(comp.getAttribute("OverrideState1"))==true||String(comp.getAttribute("OverrideState2"))==true){var str="#F0080E";var sw=2;}else if(String(comp.getAttribute("OutOfService1"))=="true"||String(comp.getAttribute("OutOfService2"))=="true"||parseInt(comp.getAttribute("ActiveCommandPriority1"))<=8||parseInt(comp.getAttribute("ActiveCommandPriority2"))<=8||parseInt(comp.getAttribute("ForcedByOperator1"))==1||parseInt(comp.getAttribute("ForcedByOperator1"))==2||parseInt(comp.getAttribute("ForcedByOperator2"))==1||parseInt(comp.getAttribute("ForcedByOperator2"))==2){var str=_getStatus(evt,3)[0];var sw=_getStatus(evt,3)[1];}else if(parseInt(comp.getAttribute("stat1"))==1||parseInt(comp.getAttribute("stat2"))==1){var str=_getStatus(evt,1)[0];var sw=_getStatus(evt,1)[1];}else if(parseInt(comp.getAttribute("stat1"))==0||parseInt(comp.getAttribute("stat2"))==0){var str=_getStatus(evt,0)[0];var sw=_getStatus(evt,0)[1];}else if(parseInt(comp.getAttribute("stat1"))==3||parseInt(comp.getAttribute("stat2"))==3){var str=_getStatus(evt,3)[0];var sw=_getStatus(evt,3)[1];}else if(parseInt(comp.getAttribute("stat1"))==2||parseInt(comp.getAttribute("stat2"))==2){var str=_getStatus(evt,2)[0];var sw=_getStatus(evt,2)[1];}var m1=comp.getChildRecursive("1").getAttribute("Stroke");try{var m2=comp.getChildRecursive("2").getAttribute("Stroke");}catch(ex){}var osw=2;if(m1=="#F0080E"||m2=="#F0080E"){var ostr="#F0080E";}else if(m1=="#FF6000"||m2=="#FF6000"){var ostr="#FF6000";}else if(m1=="#FFD100"||m2=="#FFD100"){var ostr="#FFD100";}else if(m1=="#42B4E6"||m2=="#42B4E6"){var ostr="#42B4E6";}else{var ostr="Original";osw=1;}try{if(!comp.hasAttribute("obackgroundcolour")){comp.setAttribute("obackgroundcolour",comp.getChildRecursive("background").getAttribute("Stroke"));}comp.getChildRecursive("background").setAttribute("Stroke",(ostr=="Original")?comp.getAttribute("obackgroundcolour"):ostr);comp.getChildRecursive("background").setAttribute("StrokeWidth",osw);}catch(ex){}}/*END 032*/}]]></Script>
        <Script Id="A033" Name="_finder" OnDocumentLoad="onFirstLoad" OnSignalChange=""><![CDATA[function onFirstLoad(evt){/*START 033*/_finder=function(tree,elem,att,value,e){var bindList=tree.getElementsByTagName(elem);var bLength=bindList.length;for(var i=0;i<bLength;i++){if(bindList.item(i).getAttribute("Id")!=e){bindList.item(i).setAttribute(att,value);}}}/*END 033*/}]]></Script>
        <Script Id="A034" Name="_checkAnim" OnDocumentLoad="onFirstLoad" OnSignalChange=""><![CDATA[function onFirstLoad(evt){/*START 034*/_checkAnim=function(tree,elem,att,value,e){var bindList=tree.getElementsByTagName(elem);var bLength=bindList.length;for(var i=0;i<bLength;i++){if(e){bindList.item(i).setAttribute(att,value);}}}/*END 034*/}]]></Script>
        <Script Id="A035" Name="_stateSet" OnDocumentLoad="onFirstLoad" OnSignalChange=""><![CDATA[function onFirstLoad(evt){/*START 035*/_stateSet=function(evt,st,ct){var comp=evt.getCurrentTarget();if(st=="ovr"){var str="#F0080E";var sw=2;}else{var str=_getStatus(evt,comp.getAttribute(ct+"stat"))[0];var sw=_getStatus(evt,comp.getAttribute(ct+"stat"))[1];}if(ct=="ct"){try{if(!comp.hasAttribute("oCompColour"))comp.setAttribute("oCompColour",comp.getChildRecursive("background").getAttribute("Stroke"));comp.getChildRecursive("background").setAttribute("Stroke",(str=="Original")?comp.getAttribute("oCompColour"):str);comp.getChildRecursive("background").setAttribute("StrokeWidth",sw);}catch(ex){}}else{try{if(!comp.hasAttribute(ct))comp.setAttribute(ct,comp.getChildRecursive(ct).getAttribute("Stroke"));comp.getChildRecursive(ct).setAttribute("Stroke",(str=="Original")?comp.getAttribute(ct):str);comp.getChildRecursive(ct).setAttribute("StrokeWidth",sw);}catch(ex){}}}/*END 035*/}]]></Script>
        <Script Id="A036" Name="_setTankLevels" OnDocumentLoad="onFirstLoad"><![CDATA[function onFirstLoad(evt){/*START 036*/_setTankLevels=function(evt,tankNo){switch(Number(tankNo)){case 1:var comp=evt.getCurrentTarget();var CF1=comp.getChildRecursive("Fill1");var aniH1=CF1.getChildRecursive("H");var topScale=parseFloat(comp.getAttribute("TopScale"));if(!comp.hasAttribute("hTo1"))comp.setAttribute("hTo1",50);if(!comp.hasAttribute("hFrom1"))comp.setAttribute("hFrom1",0);if(!comp.hasAttribute("hScaleFactor1"))comp.setAttribute("hScaleFactor1",parseFloat(comp.getChildRecursive("Contents1").getAttribute("Height"))/topScale);var hScaleFactor1=parseFloat(comp.getAttribute("hScaleFactor1"));var hTo1=parseFloat(comp.getAttribute("hTo1"));if(!comp.hasAttribute("val1")){var val1=Number(0.5*topScale);}else{var val1=parseFloat(comp.getAttribute("val1"));}var val1Ovr=999;if(comp.hasAttribute("LowLevel1")&&(_Bool(comp.getAttribute("onValue").split(','),comp.getAttribute("LowLevel1")))){val1Ovr=0.15*topScale;}if(comp.hasAttribute("LowLowLevel1")&&(_Bool(comp.getAttribute("onValue").split(','),comp.getAttribute("LowLowLevel1")))){val1Ovr=0.05*topScale;}if(comp.hasAttribute("HighHighLevel1")&&(_Bool(comp.getAttribute("onValue").split(','),comp.getAttribute("HighHighLevel1")))){val1Ovr=0.98*topScale;}if(comp.hasAttribute("HighLevel1")&&(_Bool(comp.getAttribute("onValue").split(','),comp.getAttribute("HighLevel1")))){val1Ovr=0.85*topScale;}comp.setAttribute("val1",val1);hTo1=val1*hScaleFactor1;if(val1<0){val1=0;}if(val1Ovr!=999){hTo1=val1Ovr*hScaleFactor1;}if(val1>topScale){hTo1=topScale*hScaleFactor1;}hFrom1=hTo1;comp.setAttribute("hFrom1",hTo1);comp.setAttribute("hTo1",hTo1);if(!isNaN(val1)){aniH1.setAttribute("Animation","Stop");aniH1.setAttribute("To",(100*hScaleFactor1)-hTo1);aniH1.setAttribute("From",(100*hScaleFactor1)-hFrom1);aniH1.setAttribute("Animation","Start");}break;case 2:var comp=evt.getCurrentTarget();var CF2=comp.getChildRecursive("Fill2");var aniH2=CF2.getChildRecursive("H");var topScale=parseFloat(comp.getAttribute("TopScale"));if(!comp.hasAttribute("hTo2"))comp.setAttribute("hTo2",50);if(!comp.hasAttribute("hFrom2"))comp.setAttribute("hFrom2",0);if(!comp.hasAttribute("hScaleFactor2"))comp.setAttribute("hScaleFactor2",parseFloat(comp.getChildRecursive("Contents2").getAttribute("Height"))/topScale);var hScaleFactor2=parseFloat(comp.getAttribute("hScaleFactor2"));var hTo2=parseFloat(comp.getAttribute("hTo2"));if(!comp.hasAttribute("val2")){var val2=Number(0.5*topScale);}else{var val2=parseFloat(comp.getAttribute("val2"));}var val2Ovr=999;if(comp.hasAttribute("LowLevel2")&&(_Bool(comp.getAttribute("onValue").split(','),comp.getAttribute("LowLevel2")))){val2Ovr=0.15*topScale;}if(comp.hasAttribute("LowLowLevel2")&&(_Bool(comp.getAttribute("onValue").split(','),comp.getAttribute("LowLowLevel2")))){val2Ovr=0.05*topScale;}if(comp.hasAttribute("HighHighLevel2")&&(_Bool(comp.getAttribute("onValue").split(','),comp.getAttribute("HighHighLevel2")))){val2Ovr=0.98*topScale;}if(comp.hasAttribute("HighLevel2")&&(_Bool(comp.getAttribute("onValue").split(','),comp.getAttribute("HighLevel2")))){val2Ovr=0.85*topScale;}comp.setAttribute("val2",val2);hTo2=val2*hScaleFactor2;if(val2<0){val2=0;}if(val2Ovr!=999){hTo2=val2Ovr*hScaleFactor2;}if(val2>topScale){hTo2=topScale*hScaleFactor2;}hFrom2=hTo2;comp.setAttribute("hFrom2",hTo2);comp.setAttribute("hTo2",hTo2);if(!isNaN(val2)){aniH2.setAttribute("Animation","Stop");aniH2.setAttribute("To",(100*hScaleFactor2)-hTo2);aniH2.setAttribute("From",(100*hScaleFactor2)-hFrom2);aniH2.setAttribute("Animation","Start");}break;}_decideStatus(evt);}/*END 036*/}]]></Script>
        <Script Id="A037" Name="_recupStatus" OnDocumentLoad="onFirstLoad"><![CDATA[function onFirstLoad(evt){/*START A037*/_recupStatus=function(evt){var comp=evt;if(String(comp.getAttribute("OverrideState1"))=="true"||String(comp.getAttribute("OverrideState1"))==true||String(comp.getAttribute("Reliability1"))=="true"||String(comp.getAttribute("Reliability1"))==true){var str="#F0080E";var sw=2;}else{if(comp.getAttribute("OutOfService1")=="true"||parseInt(comp.getAttribute("ActiveCommandPriority1"))<=8||comp.getAttribute("ForcedByOperator1")==1||parseInt(comp.getAttribute("ForcedByOperator1"))==2){var str=_getStatus(evt,3)[0];var sw=_getStatus(evt,3)[1];}else{var str=_getStatus(evt,comp.getAttribute("stat1"))[0];var sw=_getStatus(evt,comp.getAttribute("stat1"))[1];}}try{if(!comp.hasAttribute("obackgroundcolour"))comp.setAttribute("obackgroundcolour",comp.getChildRecursive("background").getAttribute("Stroke"));comp.getChildRecursive("background").setAttribute("Stroke",(str=="Original")?comp.getAttribute("obackgroundcolour"):str);comp.getChildRecursive("background").setAttribute("StrokeWidth",sw);}catch(ex){}try{if(!comp.hasAttribute("obackground1colour"))comp.setAttribute("obackground1colour",comp.getChildRecursive("background1").getAttribute("Stroke"));comp.getChildRecursive("background1").setAttribute("Stroke",(str=="Original")?comp.getAttribute("obackground1colour"):str);comp.getChildRecursive("background1").setAttribute("StrokeWidth",sw);}catch(ex){}try{if(!comp.hasAttribute("obackground2colour"))comp.setAttribute("obackground2colour",comp.getChildRecursive("background2").getAttribute("Stroke"));comp.getChildRecursive("background2").setAttribute("Stroke",(str=="Original")?comp.getAttribute("obackground2colour"):str);comp.getChildRecursive("background2").setAttribute("StrokeWidth",sw);}catch(ex){}try{if(!comp.hasAttribute("obackground3colour"))comp.setAttribute("obackground3colour",comp.getChildRecursive("background3").getAttribute("Stroke"));comp.getChildRecursive("background3").setAttribute("Stroke",(str=="Original")?comp.getAttribute("obackground3colour"):str);comp.getChildRecursive("background3").setAttribute("StrokeWidth",sw);}catch(ex){}if(String(comp.getAttribute("FbkOverrideState"))=="true"||String(comp.getAttribute("FbkOverrideState"))==true){var str="#F0080E";var sw=2;}}/*END A037*/}]]></Script>
        <Script Id="A038" Name="_chkUnitSwap" OnDocumentLoad="onFirstLoad"><![CDATA[function onFirstLoad(evt){/*START 038*/_chkUnitSwap=function(units){var reqdUnits=units;switch(String(units)){case"usgal/min":reqdUnits="GPM";break;case"ft³/min":reqdUnits="CFM";break;}return reqdUnits;}/*END 038*/}]]></Script>
        <Component Clip="False" ContentHeight="15.0"
            ContentWidth="13.95" Height="15.0" Id="AlarmGroup"
            Left="993.1309606933594" Name="" Top="142.01586151123047" Width="14.0">
            <Component Clip="False" ContentHeight="20.0"
                ContentWidth="18.6" Height="15.0"
                Left="-1.87640380859375" Name="AlarmComponent"
                Top="-1.876373291015625" Visibility="Visible" Width="13.950000000000045">
                <Component Clip="False" ContentHeight="12.9"
                    ContentWidth="12.0" Fill="#F0080E" Height="20.0"
                    Left="2.5" Top="2.5" Visibility="Visible" Width="18.604651051898315">
