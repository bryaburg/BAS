    <Script Id="UniversalPointScript" Name="UniversalPoint v3.2C" OnDocumentLoad="OnDocumentLoad"><![CDATA[/*  Universal Point
    Version 3.2C
    
    Date Created: 04/12/2017
    Date Last Edited: 03/20/2019  */

//Shared variables
var TGMLDocument;
var component;
var activeCommandPriority ="";
var priorityMetaDataValue = "";
var relinquishDefaultBindValue = "";    

//Style - Alarm
var alarmStroke = "#780407";
var alarmFill = "#F0080E";
var alarmTextboxStroke = "#FFFFFF"  
var alarmStrokeWidth = 1;
var alarmFontWeight = "Bold";

//Style - Warning
var warningStroke = "#803000";
var warningFill = "#FF6000";
var warningTextboxStroke = "#333333"
var warningStrokeWidth = 1;     

//Style - Normal
var normalStroke = "None";
var normalFill = "None";
var normalTextboxStroke = "#333333";
var normalStrokeWidth = 1;
var normalFontWeight = "Normal";

//Style - Forcing
var forceStroke = "#FFD100";
var forceStrokeWidth = 2;
var forceImage;

//Style - Locking Out - SE8000 Series
var lockoutStroke = "#0060FF";
var lockoutStrokeWidth = 2;
var lockoutImage;

//Style - Network Issues
var networkStroke = "#FF6000";
var networkStrokeWidth = 2;
var networkImage;

//General
var background;
var backgroundStroke;
var backgroundStrokeWidth;
var backgroundFill;
var textbox;
var textboxStroke;

//Filters children of parent and returns child component if only 1 exists, or an array of children if multiple exist
//nodeFilter(parent node, name of property, property value)
function nodeFilter(cComp, attrName, attrValue, searchType){
    try{
        var returnArr = [];
        switch(searchType){
            case 'children':
                var children = cComp.getChildNodes();
                break;
            case 'nested':
                var children = cComp.getElementsByTagName('*');
                break;
            default:
                var children = cComp.getChildNodes();
        }
        for (var i = 0; i < children.length; i++){
            try{
                if (children.item([i]).hasAttribute(attrName)){
                    if (children.item([i]).getAttribute(attrName) == attrValue){
                        returnArr.push(children.item([i]));
                    }
                }
            }catch(err){}
        }
        if (returnArr.length > 1){          return returnArr; }
        else if (returnArr.length > 0){     return returnArr[0]; }
        else{                               return null; }    
    }catch(err){
        global.handleError(err,component);
    }
}

//Returns boolean 1 or 0 based on if it matches a "true" state
function getBool(check){
    try{
        switch(String(check).toLowerCase()){
            case "true": case "1": case "active": case "t": case "a": case "on": case "yes": case "y": case true:
                return 1;
            default:
                return 0;
        }
    }catch(err){
        global.handleError(err,component);
    }
}

//Forcing check
function forceCheck(evt){
    try{        
        //Get target and target Id
        var target = evt.getTarget();
        var targetId = target.getAttribute("Id");
        var oosBindValue = component.getAttribute("OOS");
        var stateBindValue = component.getAttribute("State");
        /*Order of bind checking determines force state*/       
        //Priority checking must come before OutOfService checking since Values and Outputs have an unused property of OutOfService
        if(targetId == "Priority"){         
            if(activeCommandPriority == priorityMetaDataValue){
                component.setAttribute("forceState",1);
            } else {
                component.setAttribute("forceState",0);
            }           
        //OutOfService is only significant if priority and RelinquishDefault binds are null
        //Always double check for priority match since BACnet Values and Outputs have OutOfService binds that do not affect forcing
        } else if(targetId == "OutOfService"){
            if((getBool(oosBindValue) && (activeCommandPriority == "") && (relinquishDefaultBindValue == "")) || activeCommandPriority == priorityMetaDataValue){
                component.setAttribute("forceState",1);
            } else{
                component.setAttribute("forceState",0);
            }           
        //SE8000 series still indicate forcing from the priority bind, but it is necessary to ensure that RelinquishDefault value is updated
        } else if(targetId == "RelinquishDefault"){
            if(activeCommandPriority == priorityMetaDataValue){
                component.setAttribute("forceState",1);
            } else{
                component.setAttribute("forceState",0);
            }
            
        //Infinet binding is true if BACnet binds are null, but State is not
        } else if(targetId == "State"){
            if(!getBool(stateBindValue) && (oosBindValue == "") && (activeCommandPriority == "")){
                component.setAttribute("forceState",1);
            } else{
                component.setAttribute("forceState",0);
            }
            
        //If all forcing binds are null, the bound object is of SBO type        
        } else if(targetId == "Value" && (stateBindValue == "") && (oosBindValue == "") && (activeCommandPriority == "")){
            component.setAttribute("forceState",parseInt(component.getAttribute("valueBindStatus")) == 3 ? 1 : 0);
        }       
        //Issue forcing style
        //Forcing is ON properties
        if(getBool(component.getAttribute("forceState"))){
            background.setAttribute("Stroke", forceStroke);
            background.setAttribute("StrokeWidth", forceStrokeWidth);
            forceImage.setAttribute("Visibility", "Visible");           
        //Forcing is OFF properties
        } else{
            background.setAttribute("Stroke", normalStroke);
            background.setAttribute("StrokeWidth", normalStrokeWidth);
            forceImage.setAttribute("Visibility", "Hidden");
        }
    }catch(err){
        global.handleError(err,component);
    }   
}

//Lockout check
function lockoutCheck(evt){
    try{        
        //Get target and target Id
        var target = evt.getTarget();
        targetId = target.getAttribute("Id");       
        //For Viconics series controllers, if any Priority is written to, then the physical device is locked out
        if(targetId == "Priority" && getBool(component.getAttribute("Viconics")) && activeCommandPriority != priorityMetaDataValue){
            if(activeCommandPriority == "") {
                component.setAttribute("lockoutState",0);
            } else{
                component.setAttribute("lockoutState",1);
            }
        }       
        //Issue lockout styling
        //Lockout is ON properties
        if(getBool(component.getAttribute("lockoutState")) && !getBool(component.getAttribute("forceState")) && !getBool(component.getAttribute("networkState"))){
            background.setAttribute("Stroke", lockoutStroke);
            background.setAttribute("StrokeWidth", lockoutStrokeWidth);
            lockoutImage.setAttribute("Visibility", "Visible");
        
        //Lockout is OFF properties
        } else{
            if(!getBool(component.getAttribute("forceState")) && !getBool(component.getAttribute("networkState"))){
                background.setAttribute("Stroke", normalStroke);
                background.setAttribute("StrokeWidth", normalStrokeWidth);
            }
            lockoutImage.setAttribute("Visibility", "Hidden");          
        }
    }catch(err){
        global.handleError(err,component);
    }
}

//Network status check
function networkCheck(evt){
    try{
        //It is necessary to check all bindings for network issues since they are typically separate points
        if(component.getAttribute("alarmBindStatus") == "0" || component.getAttribute("warningBindStatus") == "0" || component.getAttribute("valueBindStatus") == "0"){
            component.setAttribute("networkState",1);
        } else{
            component.setAttribute("networkState",0);
        }       
        //Issue network status styling
        //Network status is in ERROR properties
        if(getBool(component.getAttribute("networkState"))){
            background.setAttribute("Stroke", networkStroke);
            background.setAttribute("StrokeWidth", networkStrokeWidth);
            networkImage.setAttribute("Visibility", "Visible");         
        //Network status is OK properties
        } else{         
            //Don't override the stroke if any of the other states are active
            if(!(Number(component.getAttribute("Alarm")) + Number(component.getAttribute("Warning")) + Number(component.getAttribute("forceState")) + Number(component.getAttribute("lockoutState")))){
                background.setAttribute("Stroke", normalStroke);
                background.setAttribute("StrokeWidth", normalStrokeWidth);
            }
            networkImage.setAttribute("Visibility", "Hidden");
        }
    }catch(err){
        global.handleError(err,component);
    }
}

//Alarm styling
function alarmStyle(){
    try{
        //Alarm is ON properties
        if(getBool(component.getAttribute("Alarm"))){           
            //Don't override the stroke if any of the other states are active
            if(!(Number(component.getAttribute("forceState")) + Number(component.getAttribute("lockoutState")) + Number(component.getAttribute("networkState")))){
                background.setAttribute("Stroke", alarmStroke);
                background.setAttribute("StrokeWidth", alarmStrokeWidth);
            }           
            //Set background and text colors
            background.setAttribute("Fill", alarmFill);
            textbox.setAttribute("Stroke", alarmTextboxStroke);
            textbox.setAttribute("FontWeight", alarmFontWeight); 
        } 
        else {      
            //Warning is ON properties
            if(getBool(component.getAttribute("Warning"))){
                
                //Don't override the stroke if any of the other states are active
                if(!(Number(component.getAttribute("forceState")) + Number(component.getAttribute("lockoutState")) + Number(component.getAttribute("networkState")))){
                    background.setAttribute("Stroke", warningStroke);
                    background.setAttribute("StrokeWidth", warningStrokeWidth);
                }
                
                //Set background and text colors
                background.setAttribute("Fill", warningFill);
                textbox.setAttribute("Stroke", warningTextboxStroke);
                textbox.setAttribute("FontWeight", normalFontWeight);               
            //Warning and Alarm are OFF poroperties 
            } else {            
                //Don't override the stroke if any of the other states are active
                if(!(Number(component.getAttribute("forceState")) + Number(component.getAttribute("lockoutState")) + Number(component.getAttribute("networkState")))){
                    background.setAttribute("Stroke", normalStroke);
                    background.setAttribute("StrokeWidth", normalStrokeWidth);
                }
                
                //Set background and text back to normal
                background.setAttribute("Fill", normalFill);
                textbox.setAttribute("Stroke", normalTextboxStroke);
                textbox.setAttribute("FontWeight", normalFontWeight);               
            }
        }
    }catch(err){
        global.handleError(err,component);
    }
}

function OnDocumentLoad(evt){
    try{
        //Get TGML document
        component = evt.getCurrentTarget();
        TGMLDocument = component.getOwnerDocument();        
        //Add event listener for SystemTheme
        TGMLDocument.addEventListener("ThemeEvent", function(e){updateComponent();}, false);
    }catch(err){
        global.handleError(err,component);
    }
}

global.handleError = function(err, cComp){
    try{    
        console.log("UniversalPoint " + err + " " + err.stack);
        //All binds should be set to null on error
        var openBinds = cComp.getElementsByTagName("Bind");
        if(openBinds.length){
            for(var i = 0; i < openBinds.length; i++){
                openBinds.item([i]).setAttribute("Name", "Error");
            }
        }       
        //Component must be visible
        cComp.setAttribute("Visibility", "Visible");
        //Error text attributes
        ERROR = TGMLDocument.createElement("TextBox");
        ERROR.setAttribute("Id", "ERROR");
        ERROR.setAttribute("Name", "ERROR");
        ERROR.setAttribute("Fill", "#505050");
        ERROR.setAttribute("Opacity", "1");
        ERROR.setAttribute("Stroke", "#FFCC00");
        ERROR.setAttribute("Visibility", "Visible");
        ERROR.setAttribute("Content", "Graphic Script Error Occurred");
        ERROR.setAttribute("FontFamily", "Arial");
        ERROR.setAttribute("FontSize", "8");
        ERROR.setAttribute("FontStyle", "Normal");
        ERROR.setAttribute("FontWeight", "Bold");
        ERROR.setAttribute("HorizontalAlign", "Center");
        ERROR.setAttribute("TextDecoration", "None");
        ERROR.setAttribute("VerticalAlign", "Middle");
        ERROR.setAttribute("Left", "0");
        ERROR.setAttribute("Top", "0");
        ERROR.setAttribute("Height", cComp.getAttribute("Height"));
        ERROR.setAttribute("Width", cComp.getAttribute("Width"));
        ERROR.setAttribute("ContentHeight", cComp.getAttribute("Height"));
        ERROR.setAttribute("ContentWidth", cComp.getAttribute("Width"));
        cComp.appendChild(ERROR);
    }catch(err){
        //If an error happens within error handling, simply print the error to the console
        console.log("Error in handling " + err + " " + err.stack);
    }
};

global.UniversalPointOnDocumentLoad = function(evt){
    try{
        //Get TGML document
        component = evt.getCurrentTarget();
        component.setAttribute("Value", component.getElementsByTagName("TextBox").item(0).getAttribute("Content"));
        component.setAttribute("Alarm",0);
        component.setAttribute("Warning",0);
        component.setAttribute("valueBindStatus", "");
        component.setAttribute("Value", "...")
        component.setAttribute("displayUnits", "");
        component.setAttribute("alarmBindStatus", "");              
        component.setAttribute("warningBindStatus", "");
        component.setAttribute("requestedValueBindValue", "");
        component.setAttribute("StateText", "");
        component.setAttribute("forceState",0);
        component.setAttribute("lockoutState",0);
        component.setAttribute("networkState",0);

        title = nodeFilter(component, "Id", "Title");
        subtitle = nodeFilter(component, "Id", "Subtitle");
        if(title.getAttribute("Content") == "")
            title.setAttribute("Visibility", "Hidden");
        if(subtitle.getAttribute("Content") == "")
            subtitle.setAttribute("Visibility", "Hidden");          
    }catch(err){
        global.handleError(err,component);
    }
};

global.UniversalPointOnSignalChange = function(evt){
    try{
        //Prevent default red X on status error
        evt.preventDefault();
        component = evt.getCurrentTarget();

        //Get forcing priority and handle null
        activeCommandPriority = Number(component.getAttribute("Priority"));     
        var priorityMetaData = nodeFilter(component, "Id", "PriorityForcing");
        priorityMetaDataValue = priorityMetaData.getAttribute("Value");
        relinquishDefaultBindValue = component.getAttribute("RelinquishDefault");       
        
        //Lots of caution should be placed around letting users define the priority
        try{
            if(priorityMetaDataValue == ""){
                priorityMetaDataValue = 8;
            }
            
            //Priority must be an integer between 1 and 16
            if(!(typeof priorityMetaDataValue === 'number' && (priorityMetaDataValue%1) === 0 && priorityMetaDataValue >= 1 && priorityMetaDataValue <= 16)){
                priorityMetaDataValue = 8;
            }
        }catch(err){
            priorityMetaDataValue = 8;
        }

        //Get background box node
        background = nodeFilter(component, "Id", "Background");
        
        //Get textbox node
        textbox = nodeFilter(component, "Id", "Textbox");
            
        //Get status image nodes
        forceImage = nodeFilter(component, "Id", "ForceImage");
        lockoutImage = nodeFilter(component, "Id", "LockoutImage");
        networkImage = nodeFilter(component, "Id", "NetworkImage");

        //Get target and target Id
        var target = evt.getTarget();
        var targetId = target.getAttribute("Id");

        // Capture bind statuses and store in component attributes
        switch(String(targetId).toLowerCase()){
            case "value":
                component.setAttribute("valueBindStatus", evt.getStatus());
                if(component.getAttribute("Units") == "")
                    component.setAttribute("displayUnits", evt.getUnit());
                else
                    component.setAttribute("displayUnits", component.getAttribute("Units"));

                //Check for point type
                switch(String(component.getAttribute("PointType")).toLowerCase()){
                    case "d": case "digital": case "b": case "binary":          
                        //Logic for digital display
                        //Get digital properties
                        digitalOn = component.getAttribute("DigitalOn");
                        digitalOff = component.getAttribute("DigitalOff");                      
                        //Handle null digital properties
                        if(digitalOn == ""){
                            digitalOn = "Active";
                        }
                        if(digitalOff == ""){
                            digitalOff = "Inactive";
                        }                       
                        getBool(component.getAttribute("Value")) ? textbox.setAttribute("Content", digitalOn) : textbox.setAttribute("Content", digitalOff);
                        break;              
                    case "s": case "string":                
                        //Strings just return whatever was provided
                        textbox.setAttribute("Content", component.getAttribute("Value"));
                        break;              
                    case "t": case "tristate": case "m": case "multistate": 
                        //Initialize blank variable to hold final multistate text
                        var multistateText;
                        //Handle null statetext properties
                        if(component.getAttribute("StateText") == ""){
                            multistateText = component.getAttribute("Value");
                        } else{             
                            //Get current bind value for StateText input bind
                            var arr = component.getAttribute("StateText").split(";");
                            //Properly adjust array indexing
                            multistateText = arr[Number(component.getAttribute("Value")) - 1];                  
                            //Handle undefined
                            if(typeof multistateText == "undefined"){
                                multistateText = Number(component.getAttribute("Value"));
                            }
                        }

                        //Get statetext and parse into array
                        var stateTextInput = {};
                        var stateTextArr = String(component.getAttribute("StateTextInput")).split(",");
                        for(var i = 0; i < stateTextArr.length; i++){
                            var arr = stateTextArr[i].split(":");
                            if(arr[1] == "" || arr[1] == null || typeof arr[1] == "undefined"){
                                arr[1] = String(arr[0]);
                            }
                            stateTextInput[arr[0]] = arr[1];
                        }

                        //Override StateText input bind value with custom if exists
                        Object.keys(stateTextInput).forEach(function(key){
                            if(String(component.getAttribute("Value")) == String(key)){
                                multistateText = stateTextInput[key];
                            }
                        });             
                        //Set UP text
                        textbox.setAttribute("Content", multistateText);
                        break;              
                    default:
                        //Get decimals
                        var decimals = parseInt(component.getAttribute("Decimals"));                        
                        //Handle null decimals
                        if(decimals == ""){
                            decimals = 0;
                        }                   
                        if(getBool(component.getAttribute("AnalogConversion"))){                
                            //Adjust value if conversion property was set to true
                            var conversionInputMin = component.getAttribute("ConversionInputMin");
                            var conversionInputMax = component.getAttribute("ConversionInputMax");
                            var conversionOutputMin = component.getAttribute("ConversionOutputMin");
                            var conversionOutputMax = component.getAttribute("ConversionOutputMax");
                            
                            //Handle null conversion properties
                            if(conversionInputMin == ""){
                                conversionInputMin = 0;
                            }
                            if(conversionInputMax == ""){
                                conversionInputMax = 10;
                            }
                            if(conversionOutputMin == ""){
                                conversionOutputMin = 0;
                            }
                            if(conversionOutputMax == ""){
                                conversionOutputMax = 100;
                            }                           
                            //Convert values to Number
                            conversionInputMin = Number(conversionInputMin);
                            conversionInputMax = Number(conversionInputMax);
                            conversionOutputMin = Number(conversionOutputMin);
                            conversionOutputMax = Number(conversionOutputMax);

                            var calculated = ((Number(component.getAttribute("Value"))-conversionInputMin) / (conversionInputMax - conversionInputMin)) * (conversionOutputMax - conversionOutputMin) + conversionOutputMin;                    
                            //Add decimals
                            component.setAttribute("Value", calculated.toFixed(decimals));
                        } else{                 
                            //If no conversion, only set decimals on bind value
                            component.setAttribute("Value", parseFloat(component.getAttribute("Value")).toFixed(decimals));
                        }               
                        //Add units if they exist
                        if(component.getAttribute("displayUnits") == "")
                            textbox.setAttribute("Content", component.getAttribute("Value"));
                        else
                            textbox.setAttribute("Content", component.getAttribute("Value") + " " + component.getAttribute("displayUnits"));                
                }    
                break;          
            case "alarm":
                component.setAttribute("alarmBindStatus", evt.getStatus()); 
                // Edit if multiple alarms exist, set attribute to Alarm1, Alarm2... etc.
                // Loop through to see if any are active and set Alarm attribute, otherwise just read Alarm attribute
                var alarmBind = nodeFilter(component, "Id", "Alarm");
                if(alarmBind.length > 1){
                    for(var i = 1; i <= alarmBind.length; i++) {
                        if(getBool(component.getAttribute("Alarm"+i))){
                            component.setAttribute("Alarm",1);
                            break;
                        }
                        component.setAttribute("Alarm",0);
                    }
                }
                break;
            case "warning":
                var warningBind = nodeFilter(component, "Id", "Warning");
                component.setAttribute("warningBindStatus", evt.getStatus());  
                // Edit if multiple warnings exist, set attribute to Warning1, Warning2... etc.
                // Loop through to see if any are activeand set Warning attribute, otherwise just read Warning attribute
                if(warningBind.length > 1){
                    for(var i = 1; i <= warningBind.length; i++) {
                        if(getBool(component.getAttribute("Warning"+i))){
                            component.setAttribute("Warning",1);
                            break;
                        }
                        component.setAttribute("Warning",0);
                    }
                }
                break;
        }

        //Order of checks determines priority in viewing
        
        //Check for forcing
        forceCheck(evt);
        
        //Check for SE8000 device lockout
        lockoutCheck(evt);
        
        //Check for network status
        networkCheck(evt);
        
        //Issue alarm styling at end to always guarantee that alarming is shown
        alarmStyle();

    }catch(err){
        global.handleError(err,component);
    }
};

global.UniversalPointOnMouseClick = function(evt){
    try{
        //Only do things if left-clicked
        //This allows right clicking to bring up bind options
        if(evt.getButton() == 0){
            //Prevent default action
            evt.preventDefault();
            component = evt.getCurrentTarget();
            var valueBind = nodeFilter(component, "Id", "Value");
            var requestedValueBind = nodeFilter(component, "Id", "RequestedValue");
            var relinquishDefaultBind = nodeFilter(component, "Id", "RelinquishDefault");

            //Check for SE8000 series
            if(getBool(component.getAttribute("Viconics"))){
                //Clicking should open .../RelinquishDefault properties, not .../Value properties, if it exists
                if(relinquishDefaultBindValue == ""){
                    invoke(valueBind.getFullBindName(), "EditProperties");
                } else{
                    invoke(relinquishDefaultBind.getFullBindName(), "EditProperties");
                }
            //Check for SBO output
            }
            else{
                if(component.getAttribute("requestedValueBindValue") != ""){
                    //Clicking should open .../RequestedValue properties, not .../Value properties, if it exists
                    invoke(requestedValueBind.getFullBindName(), "EditProperties");
                } else{
                    //Otherwise, open .../Value properties
                    invoke(valueBind.getFullBindName(), "EditProperties");
                }
            }
        }
    }catch(err){
        global.handleError(err,component);
    }
};]]></Script>
    <Group Name="Position and Visibility">
        <Bind Attribute="RhtSelect" Name="RhtSelect.Value" PreventDefault="True"/>
        <Bind Attribute="FanSelect" Name="FanSelect.Value" PreventDefault="True"/>
        <Bind Attribute="RmCO2Ena" Name="RmCO2Ena.Value" PreventDefault="True"/>
        <Bind Attribute="RmRhEna" Name="RmRhEna.Value" PreventDefault="True"/>
        <Script Name="Position and Visibility"
            OnDocumentLoad="OnDocumentLoad" OnSignalChange="OnSignalChange"><![CDATA[/* 
This script will control the visibility and positioning of 
dynamic elements on the graphic.  
*/

var ElecHeat1Stage;
var ElecHeat2Stage;   
var ElecHeat3Stage;   
var EhPos;   
var HwValve;
var SeriesFan;            
var ParallelFan;
    
var Rht1Cmd;
var Rht2Cmd;
var EhPosValue;
var RhtPos;    
var FanCmd;    
var FanSts;   
var AirFlSptMax;
var AirFlSptRhtMax;
var AirFlSptRhtMin;
var AirFlSptMin;
var AirFlSptAbsMin;
var FlowSptRectangle;

var RmTmp;
var RmTmpSpt;
var RmCO2;
var RmRh;
var OccOvrSts;

var RhtValuesXoffset;
var RhtValuesYoffset;
var FlowValuesXoffset;
var FlowValuesYoffset;
var RDUValuesXoffset;
var RDUValuesYoffset;
var AirFlValuesXoffset;
var AirFlValuesYoffset;

var TitleYstep = 45;
var SubtitleYStep = 30;

function OnDocumentLoad(evt){
    var component = evt.getCurrentTarget();
    var doc = component.getOwnerDocument();
    
    // Define graphical elements
    ElecHeat1Stage = doc.getElementById("ElecHeat1Stage");
    ElecHeat2Stage = doc.getElementById("ElecHeat2Stage");
    ElecHeat3Stage = doc.getElementById("ElecHeat3Stage");
    EhPos = doc.getElementById("EhPos");
    HwValve = doc.getElementById("HwValve");
    SeriesFan = doc.getElementById("SeriesFan");
    ParallelFan = doc.getElementById("ParallelFan");
    FlowSptRectangle = doc.getElementById("FlowSptRectangle");
    
    // Define point displays
    Rht1Cmd = doc.getElementById("Rht1Cmd");
    Rht2Cmd = doc.getElementById("Rht2Cmd");
    EhPosValue = doc.getElementById("EhPosValue");
    RhtPos = doc.getElementById("RhtPos");    
    FanCmd = doc.getElementById("FanCmd");
    FanSts = doc.getElementById("FanSts");   
    AirFlSptMax = doc.getElementById("AirFlSptMax");  
    AirFlSptRhtMax = doc.getElementById("AirFlSptRhtMax");  
    AirFlSptRhtMin = doc.getElementById("AirFlSptRhtMin");  
    AirFlSptMin = doc.getElementById("AirFlSptMin");  
    AirFlSptAbsMin = doc.getElementById("AirFlSptAbsMin");  
    RmTmp = doc.getElementById("RmTmp");  
    RmTmpSpt = doc.getElementById("RmTmpSpt");  
    RmCO2 = doc.getElementById("RmCO2");  
    RmRh = doc.getElementById("RmRh");  
    OccOvrSts = doc.getElementById("OccOvrSts");  
  
    // Grab and share initial position   
    RhtValuesXoffset = Number(Rht1Cmd.getAttribute("Left"));
    RhtValuesYoffset = Number(Rht1Cmd.getAttribute("Top"));      
    FlowValuesXoffset = Number(AirFlSptMax.getAttribute("Left"));
    FlowValuesYoffset = Number(AirFlSptMax.getAttribute("Top"));     
    RDUValuesXoffset = Number(RmTmp.getAttribute("Left"));
    RDUValuesYoffset = Number(RmTmp.getAttribute("Top"));  
    
    Rht2Cmd.setAttribute("Left",RhtValuesXoffset);
    EhPosValue.setAttribute("Left",RhtValuesXoffset);
    RhtPos.setAttribute("Left",RhtValuesXoffset);
    Rht2Cmd.setAttribute("Top",RhtValuesYoffset);
    EhPosValue.setAttribute("Top",RhtValuesYoffset);
    RhtPos.setAttribute("Top",RhtValuesYoffset); 
    
    AirFlSptRhtMax.setAttribute("Left",FlowValuesXoffset);
    AirFlSptRhtMin.setAttribute("Left",FlowValuesXoffset);
    AirFlSptMin.setAttribute("Left",FlowValuesXoffset);
    AirFlSptAbsMin.setAttribute("Left",FlowValuesXoffset);  
    
    // Default graphical elements and point displays to hidden until selector values are known
    ElecHeat1Stage.setAttribute("Visibility","Hidden");
    ElecHeat2Stage.setAttribute("Visibility","Hidden");  
    ElecHeat3Stage.setAttribute("Visibility","Hidden");     
    EhPos.setAttribute("Visibility","Hidden");         
    HwValve.setAttribute("Visibility","Hidden");
    SeriesFan.setAttribute("Visibility","Hidden");            
    ParallelFan.setAttribute("Visibility","Hidden");
    
    Rht1Cmd.setAttribute("Visibility","Hidden");
    Rht2Cmd.setAttribute("Visibility","Hidden");
    EhPosValue.setAttribute("Visibility","Hidden");
    RhtPos.setAttribute("Visibility","Hidden");    
    FanCmd.setAttribute("Visibility","Hidden");    
    FanSts.setAttribute("Visibility","Hidden"); 
    RmCO2.setAttribute("Visibility","Hidden");    
    RmRh.setAttribute("Visibility","Hidden");  

    AirFlSptRhtMax.setAttribute("Visibility","Hidden"); 
    AirFlSptRhtMin.setAttribute("Visibility","Hidden"); 
    
    RmTmpSpt.setAttribute("Top",RDUValuesYoffset+SubtitleYStep);   
    OccOvrSts.setAttribute("Top",RDUValuesYoffset+SubtitleYStep*2);
    AirFlSptMin.setAttribute("Top",FlowValuesYoffset+SubtitleYStep);
    AirFlSptAbsMin.setAttribute("Top",FlowValuesYoffset+SubtitleYStep*2);                  
    FlowSptRectangle.setAttribute("Height",200-SubtitleYStep*2);    
}

function OnSignalChange(evt){
    /*1- No Reheat
    2- One Stage EH
    3- Two Stage EH
    4- Three Stage EH
    5- Proportional EH
    6- Floating HW
    7- Proportional HW
    8- Two Position*/
    
    var component = evt.getCurrentTarget();
    RhtSelect = Number(component.getAttribute("RhtSelect"));
    FanSelect = Number(component.getAttribute("FanSelect"));
    RmCO2Ena = Number(component.getAttribute("RmCO2Ena"));
    RmRhEna = Number(component.getAttribute("RmRhEna"));
        
    switch(RhtSelect){
        case 2: // One Stage EH
            ElecHeat1Stage.setAttribute("Visibility","Visible");
            ElecHeat2Stage.setAttribute("Visibility","Hidden");
            ElecHeat3Stage.setAttribute("Visibility","Hidden");
            EhPos.setAttribute("Visibility","Hidden");
            HwValve.setAttribute("Visibility","Hidden");   
            Rht1Cmd.setAttribute("Visibility","Visible");
            Rht2Cmd.setAttribute("Visibility","Hidden");
            EhPosValue.setAttribute("Visibility","Hidden");
            RhtPos.setAttribute("Visibility","Hidden");                   
            break;
        case 3: // Two Stage EH
            ElecHeat1Stage.setAttribute("Visibility","Hidden");
            ElecHeat2Stage.setAttribute("Visibility","Visible");
            ElecHeat3Stage.setAttribute("Visibility","Hidden");
            EhPos.setAttribute("Visibility","Hidden");
            HwValve.setAttribute("Visibility","Hidden");  
            Rht1Cmd.setAttribute("Visibility","Visible");
            Rht2Cmd.setAttribute("Visibility","Visible");
            EhPosValue.setAttribute("Visibility","Hidden");
            RhtPos.setAttribute("Visibility","Hidden"); 
            Rht2Cmd.setAttribute("Top",RhtValuesYoffset+TitleYstep);                             
            break;
        case 4: // Three Stage EH
            ElecHeat1Stage.setAttribute("Visibility","Hidden");
            ElecHeat2Stage.setAttribute("Visibility","Hidden");
            ElecHeat3Stage.setAttribute("Visibility","Visible");
            EhPos.setAttribute("Visibility","Hidden");
            HwValve.setAttribute("Visibility","Hidden");        
            Rht1Cmd.setAttribute("Visibility","Visible");
            Rht2Cmd.setAttribute("Visibility","Visible");
            EhPosValue.setAttribute("Visibility","Hidden");
            RhtPos.setAttribute("Visibility","Hidden"); 
            Rht2Cmd.setAttribute("Top",RhtValuesYoffset+TitleYstep);                      
            break;        
        case 5: // Proportional EH
            ElecHeat1Stage.setAttribute("Visibility","Hidden");
            ElecHeat2Stage.setAttribute("Visibility","Hidden");
            ElecHeat3Stage.setAttribute("Visibility","Hidden");
            EhPos.setAttribute("Visibility","Visible");
            HwValve.setAttribute("Visibility","Hidden");        
            Rht1Cmd.setAttribute("Visibility","Hidden");
            Rht2Cmd.setAttribute("Visibility","Hidden");
            EhPosValue.setAttribute("Visibility","Visible");
            RhtPos.setAttribute("Visibility","Hidden");                 
            break;
        case 6: case 7: case 8: // Floating HW, Proportional HW, Two Position HW
            ElecHeat1Stage.setAttribute("Visibility","Hidden");
            ElecHeat2Stage.setAttribute("Visibility","Hidden");
            ElecHeat3Stage.setAttribute("Visibility","Hidden");
            EhPos.setAttribute("Visibility","Hidden");
            HwValve.setAttribute("Visibility","Visible");        
            Rht1Cmd.setAttribute("Visibility","Hidden");
            Rht2Cmd.setAttribute("Visibility","Hidden");
            EhPosValue.setAttribute("Visibility","Hidden");
            RhtPos.setAttribute("Visibility","Visible");               
            break;          
        default: // No Heat
            ElecHeat1Stage.setAttribute("Visibility","Hidden");
            ElecHeat2Stage.setAttribute("Visibility","Hidden");
            ElecHeat3Stage.setAttribute("Visibility","Hidden");   
            EhPos.setAttribute("Visibility","Hidden");   
            HwValve.setAttribute("Visibility","Hidden");
            Rht1Cmd.setAttribute("Visibility","Hidden");
            Rht2Cmd.setAttribute("Visibility","Hidden");
            EhPosValue.setAttribute("Visibility","Hidden");
            RhtPos.setAttribute("Visibility","Hidden");  
            AirFlSptRhtMax.setAttribute("Visibility","Hidden");  
            AirFlSptRhtMin.setAttribute("Visibility","Hidden");      
    }   
    
    if((RhtSelect > 1) & (RhtSelect < 9)){
        // Show reheat air flow setpoints
        AirFlSptRhtMax.setAttribute("Visibility","Visible");  
        AirFlSptRhtMin.setAttribute("Visibility","Visible");  
        FlowSptRectangle.setAttribute("Height",200);
        AirFlSptRhtMax.setAttribute("Top",FlowValuesYoffset+SubtitleYStep);
        AirFlSptRhtMin.setAttribute("Top",FlowValuesYoffset+SubtitleYStep*2);
        AirFlSptMin.setAttribute("Top",FlowValuesYoffset+SubtitleYStep*3);
        AirFlSptAbsMin.setAttribute("Top",FlowValuesYoffset+SubtitleYStep*4);          
    }
    else{
        // Hide reheat air flow setpoints
        AirFlSptRhtMax.setAttribute("Visibility","Hidden");  
        AirFlSptRhtMin.setAttribute("Visibility","Hidden");  
        FlowSptRectangle.setAttribute("Height",200-SubtitleYStep*2);
        AirFlSptMin.setAttribute("Top",FlowValuesYoffset+SubtitleYStep);
        AirFlSptAbsMin.setAttribute("Top",FlowValuesYoffset+SubtitleYStep*2);          
    }
    
    switch(FanSelect){
    /*1- No Fan
    2- Parallel Fan
    3- Series Fan*/    
        case 2:
            SeriesFan.setAttribute("Visibility","Hidden");            
            ParallelFan.setAttribute("Visibility","Visible");     
            FanCmd.setAttribute("Visibility","Visible");    
            FanSts.setAttribute("Visibility","Visible");                
            break;
        case 3: 
            SeriesFan.setAttribute("Visibility","Visible");            
            ParallelFan.setAttribute("Visibility","Hidden");          
            FanCmd.setAttribute("Visibility","Visible");    
            FanSts.setAttribute("Visibility","Visible");              
            break;
        default:
            SeriesFan.setAttribute("Visibility","Hidden");            
            ParallelFan.setAttribute("Visibility","Hidden");
            FanCmd.setAttribute("Visibility","Hidden");    
            FanSts.setAttribute("Visibility","Hidden");                       
    }
    
    if(RmCO2Ena > 0){
        if(RmRhEna > 0){
            // Both CO2 and Humidity Enabled
            RmCO2.setAttribute("Visibility","Visible");    
            RmRh.setAttribute("Visibility","Visible");   
            RmTmpSpt.setAttribute("Top",RDUValuesYoffset+SubtitleYStep);
            RmCO2.setAttribute("Top",RDUValuesYoffset+SubtitleYStep*2);      
            RmRh.setAttribute("Top",RDUValuesYoffset+SubtitleYStep*3); 
            OccOvrSts.setAttribute("Top",RDUValuesYoffset+SubtitleYStep*4); 
        }
        else{
            // Only CO2 Enabled
            RmCO2.setAttribute("Visibility","Visible");    
            RmRh.setAttribute("Visibility","Hidden");         
            RmTmpSpt.setAttribute("Top",RDUValuesYoffset+SubtitleYStep);
            RmCO2.setAttribute("Top",RDUValuesYoffset+SubtitleYStep*2);      
            OccOvrSts.setAttribute("Top",RDUValuesYoffset+SubtitleYStep*3);             
        }
    }
    else{
        if(RmRhEna > 0){
            // Only Humidity Enabled
            RmCO2.setAttribute("Visibility","Hidden");    
            RmRh.setAttribute("Visibility","Visible");     
            RmTmpSpt.setAttribute("Top",RDUValuesYoffset+SubtitleYStep);
            RmRh.setAttribute("Top",RDUValuesYoffset+SubtitleYStep*2);      
            OccOvrSts.setAttribute("Top",RDUValuesYoffset+SubtitleYStep*3);                
        }
        else{
            // Neither CO2 nor Humidity Enabled
            RmCO2.setAttribute("Visibility","Hidden");    
            RmRh.setAttribute("Visibility","Hidden");  
            RmTmpSpt.setAttribute("Top",RDUValuesYoffset+SubtitleYStep);   
            OccOvrSts.setAttribute("Top",RDUValuesYoffset+SubtitleYStep*2);                   
        }    
    }
    
}]]></Script>
    </Group>
