        <Script Fill="#333333" OnDocumentLoad="onLoad"
            OnMouseClick="onClick" OnMouseDown="onDown"
            OnMouseOut="onOut" OnMouseOver="onOver" OnMouseUp="onUp"
                Stroke="#3DCD58"><![CDATA[var comp;
var aniArr = new Array;
var From;
var To;

function onLoad(evt){
    comp = evt.getCurrentTarget();
    aniArr = comp.getElementsByTagName("Animate");
    var scr = comp.getElementsByTagName("Script").item(0);
    From = scr.getAttribute("Fill");
    To = scr.getAttribute("Stroke");
    }

function onOver(evt){
    for(var i=0; i < aniArr.length; i++){
        aniArr.item(i).setAttribute("Animation", "Stop");
        aniArr.item(i).setAttribute("To", To);
        aniArr.item(i).setAttribute("From", From);
        aniArr.item(i).setAttribute("Animation", "Start");
    }
}

function onOut(evt){
    for(var i=0; i < aniArr.length; i++){
        aniArr.item(i).setAttribute("Animation", "Stop");
        aniArr.item(i).setAttribute("From", aniArr.item(i).getAttribute("To"));
        aniArr.item(i).setAttribute("To", From);
        aniArr.item(i).setAttribute("Animation", "Start");
    }
}

function onUp(evt){
    evt.preventDefault();
    for(var i=0; i < aniArr.length; i++){
        aniArr.item(i).setAttribute("Animation", "Stop");
        aniArr.item(i).setAttribute("From", aniArr.item(i).getAttribute("To"));
        aniArr.item(i).setAttribute("To", To);
        aniArr.item(i).setAttribute("Animation", "Start");
    }
}

function onDown(evt){
    evt.preventDefault();
    for(var i=0; i < aniArr.length; i++){
        aniArr.item(i).setAttribute("Animation", "Stop");
        aniArr.item(i).setAttribute("From", aniArr.item(i).getAttribute("To"));
        aniArr.item(i).setAttribute("To", "#626469");
        aniArr.item(i).setAttribute("Animation", "Start");
    }
}

function onClick(evt){
    evt.preventDefault();
    if(!invoke(comp.getElementsByTagName("Link").item(0).getFullBindName(), "OpenInNewWindow")){
        comp.setAttribute("Visibility", "Hidden");
        comp.getOwnerDocument().getElementById("Schedule").setAttribute("Top",170);        
    }
}]]><Expose
                ExposedAttribute="Fill" Name="Icon Symbol Fill"/>
            <Expose ExposedAttribute="Stroke" Name="Icon Symbol Mouse Over"/>
        </Script>
