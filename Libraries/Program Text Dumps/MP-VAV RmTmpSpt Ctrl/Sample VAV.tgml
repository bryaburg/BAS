                <Bind Name="Temperature.Value">
                    <Script Name="LCD Units" OnDocumentLoad=""
                        OnMouseClick="" OnSignalChange="OnSignalChange"><![CDATA[var on = "#333333";
var off = "#10000000";

function OnSignalChange(evt){
	evt.preventDefault();
    component = evt.getTarget().getParentNode();
	var units = evt.getUnit();
	degF = component.getChild("°F");
    degC = component.getChild("°C");

    if(units == "°C"){
        degC.setAttribute("Fill", on);
        degF.setAttribute("Fill", off);
    }
    else{
        degF.setAttribute("Fill", on);
        degC.setAttribute("Fill", off);
    }
}
]]></Script>
                </Bind>
