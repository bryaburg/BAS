			digit.getChild("c").setAttribute("Fill", on);
			digit.getChild("d").setAttribute("Fill", off);
			digit.getChild("e").setAttribute("Fill", off);
			digit.getChild("f").setAttribute("Fill", off);
			digit.getChild("g").setAttribute("Fill", off);
			break;
		case "8":
			digit.getChild("a").setAttribute("Fill", on);
			digit.getChild("b").setAttribute("Fill", on);
			digit.getChild("c").setAttribute("Fill", on);
			digit.getChild("d").setAttribute("Fill", on);
			digit.getChild("e").setAttribute("Fill", on);
			digit.getChild("f").setAttribute("Fill", on);
