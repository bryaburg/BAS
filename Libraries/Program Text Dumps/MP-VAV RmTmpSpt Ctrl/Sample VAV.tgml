            <Bind Name="Temperature.Value">
                <Script Name="SmartX Touch Screen"
                    OnMouseClick="OnMouseClick"
                    OnMouseDown="OnMouseDown" OnMouseUp="OnMouseUp" OnSignalChange="OnSignalChange"><![CDATA[function OnSignalChange(evt){
    evt.preventDefault();
    
    var value = evt.getValue();
    var units = evt.getUnit();
    
    var component = evt.getTarget().getParentNode();
    var integerDisplay = component.getChild("Integer");
    var decimalDisplay = component.getChild("Decimals");
    var unitDisplay = component.getChild("Units");
    
    var integer = Math.floor(value);
    var decimals = ".0";
    if(!isNaN(value % integer))
        var decimals = (value % integer).toFixed(1).substring(1,3);
    
    integerDisplay.setAttribute("Content", integer);
    decimalDisplay.setAttribute("Content", decimals);
    unitDisplay.setAttribute("Content", units);
    
    var timeDisplay = component.getChild("Time");
    var today = new Date();
    var hours = today.getHours();
    var minutes = today.getMinutes();
    var ampm = "AM";
    if(hours >= 12){
        ampm = "PM";
        if(hours > 12){
            hours = hours - 12;
        }
    }
    if(minutes < 10){
        minutes = "0"+minutes;
    }
    timeDisplay.setAttribute("Content", hours+":"+minutes+" "+ampm);
    
    
}

function OnMouseClick(evt){
    evt.preventDefault();
}

function OnMouseDown(evt){
    evt.preventDefault();
}

function OnMouseUp(evt){
    evt.preventDefault();
}
]]></Script>
            </Bind>
        </Group>
        <Rectangle Fill="None" Height="30.0" Id="" Left="158.0"
            Name="PIR" Opacity="1.0" RadiusX="13" RadiusY="13"
            Stroke="#A0A0A0" StrokeDashArray="0.0" StrokeWidth="1.0"
            Top="498.0" Width="114.0"/>
        <Bind Name="Room Unit Device.CoverModel">
            <Script Name="SmartX Display" OnMouseClick="" OnMouseDown=""
                OnMouseUp="" OnSignalChange="OnSignalChange"><![CDATA[function OnSignalChange(evt){
    evt.preventDefault();
    
    component = evt.getTarget().getParentNode();
    
    covermodel = evt.getValue().toLowerCase().substring(5,6);
    occsensor = evt.getValue().toLowerCase().substring(6,7);
    assembly = evt.getValue().toLowerCase().substring(9,12);
    
    switch(covermodel){
        case "d":
            component.getChild("Touchscreen").setAttribute("Visibility", "Visible");
            component.getChild("LCD").setAttribute("Visibility", "Hidden");
            component.getChild("3 Button").setAttribute("Visibility", "Hidden");
            break;
        case "3":
            component.getChild("Touchscreen").setAttribute("Visibility", "Hidden");
            component.getChild("LCD").setAttribute("Visibility", "Hidden");
            component.getChild("3 Button").setAttribute("Visibility", "Visible");        
            break;
        default:
            component.getChild("Touchscreen").setAttribute("Visibility", "Hidden");            
            component.getChild("3 Button").setAttribute("Visibility", "Hidden");
            if(assembly == "slx"){
                component.getChild("LCD").setAttribute("Visibility", "Visible");
            }
            else{
                component.getChild("LCD").setAttribute("Visibility", "Hidden");
            }
            break;
    }
    
    if(occsensor == "p"){
        component.getChild("PIR").setAttribute("Visibility", "Visible");
    }
    else{
        component.getChild("PIR").setAttribute("Visibility", "Hidden");
    }
}
]]></Script>
        </Bind>
        <Script Name="preventDefault" OnMouseClick="OnMouseClick"
            OnMouseDown="OnMouseDown" OnMouseUp="OnMouseUp" OnSignalChange="OnSignalChange"><![CDATA[function OnSignalChange(evt){
    evt.preventDefault();
}

function OnMouseClick(evt){
    evt.preventDefault();
}

function OnMouseDown(evt){
    evt.preventDefault();
}

function OnMouseUp(evt){
    evt.preventDefault();
}]]></Script>
