        </Metadata>
        <Script Fill="#333333" OnDocumentLoad="onLoad"
            OnMouseClick="onClick" OnMouseDown="onDown"
            OnMouseOut="onOut" OnMouseOver="onOver" OnMouseUp="onUp"
            OnSignalChange="onChange"
                Stroke="#3DCD58"><![CDATA[var comp;
var aniArr = new Array;
var active = false;
var onValue;
var rtnArray = new Array();
var From;
var To;

function onLoad(evt)
{
    comp = evt.getCurrentTarget();
    comp.setAttribute("Visibility","Hidden");
    aniArr = comp.getElementsByTagName("Animate");
    onValue=buildArray(comp.getAttribute("OnValue").split(','));
    var scr = comp.getElementsByTagName("Script").item(1);
    From = scr.getAttribute("Fill");
    To = scr.getAttribute("Stroke");
}

function onOver(evt)
{
    for(var i=0; i < aniArr.length; i++){
        aniArr.item(i).setAttribute("Animation", "Stop");
        aniArr.item(i).setAttribute("To", To);
        if(aniArr.item(i).getAttribute("Name") == "aniIcon" && active) aniArr.item(i).setAttribute("To", "#009530"); 
        aniArr.item(i).setAttribute("From", From);
        aniArr.item(i).setAttribute("Animation", "Start");
    }
}

function onOut(evt)
{
    for(var i=0; i < aniArr.length; i++){
        aniArr.item(i).setAttribute("Animation", "Stop");
        aniArr.item(i).setAttribute("From", aniArr.item(i).getAttribute("To"));
        aniArr.item(i).setAttribute("To", From);
        aniArr.item(i).setAttribute("Animation", "Start");
    }
}

function onUp(evt)
{
    for(var i=0; i < aniArr.length; i++){
        aniArr.item(i).setAttribute("Animation", "Stop");
        aniArr.item(i).setAttribute("From", aniArr.item(i).getAttribute("To"));
        aniArr.item(i).setAttribute("To", To);
        if(aniArr.item(i).getAttribute("Name") == "aniIcon" && active) aniArr.item(i).setAttribute("To", "#009530"); 
        aniArr.item(i).setAttribute("Animation", "Start");
    }
}

function onDown(evt)
{
    for(var i=0; i < aniArr.length; i++){
        aniArr.item(i).setAttribute("Animation", "Stop");
        aniArr.item(i).setAttribute("From", aniArr.item(i).getAttribute("To"));
        aniArr.item(i).setAttribute("To", "#626469");
        aniArr.item(i).setAttribute("Animation", "Start");
    }
}

function onClick(evt)
{
    evt.preventDefault();
    invoke(comp.getElementsByTagName("Link").item(0).getFullBindName(), "OpenInNewWindow");
}

function onChange(evt)
{
    comp.setAttribute("Visibility","Visible");
    var value = evt.getValue();
    if (isNumber(value)) value = Math.round(value);
    active = Bool(value);
}

function Bool(val){
    for (var i=0;i<onValue.length;i++){
        if(String(val).toLowerCase() == String(onValue[i]).toLowerCase())
        {
            return true;
        }
    }
    return false;
}

function buildArray(Array){
    for (var i=0;i<Array.length;i++){
        if (isNumber(Array[i]) || Array[i]=="true" || Array[i]=="false" ){
            rtnArray[i] = Array[i]
        }
        else{
            rtnArray[i] = "'" + Array[i] + "'";
        }
    }
    return rtnArray;
}

function isNumber (o) {
  return ! isNaN (o-0) && o != null;
}]]><Expose
                ExposedAttribute="Fill" Name="Icon Symbol Fill"/>
            <Expose ExposedAttribute="Stroke" Name="Icon Symbol Mouse Over"/>
        </Script>
