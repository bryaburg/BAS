                Stroke="#404040" StrokeDashArray="0.0" StrokeWidth="1">
                <Bind Color="#F0080E" Fill="#FFD100" Name="SaFanCmd" Stroke="#42B4E6">
                    <Expose ExposedAttribute="Color" Name="Error Color"/>
                    <Expose ExposedAttribute="Fill" Name="Forced Color"/>
