                OnDocumentLoad="onDocumentLoad"
                OnMouseClick="onMouseClick" OnMouseDown=""
                OnMouseMove="" OnMouseOut="" OnMouseOver="" OnMouseUp="" OnSignalChange="onSignalChange"><![CDATA[/*  
