                ContentWidth="20.0" Height="20.0" Id="NetworkImage"
                Left="105" Top="0" Visibility="Hidden" Width="20.0">
                <Rectangle Fill="#FF6000" Height="20.0" Left="0.0"
                    RadiusX="5" RadiusY="5" Stroke="#FF6000"
                    SystemThemeEnable="True"
                    SystemThemeRules="RadiusX:UP_RADIUSX;RadiusY:UP_RADIUSY"
                    Top="0.0" Width="20.0"/>
                <Component Clip="False" ContentHeight="75.0"
                    ContentWidth="85.0" Height="13.235294446349144"
                    Left="2.5" Top="3.382352828979492" Width="15.0">
