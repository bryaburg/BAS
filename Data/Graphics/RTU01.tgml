            <Script Name="script" OnDocumentLoad="onLoad"
                OnMouseClick="onClick" OnMouseDown="onDown"
                OnMouseOut="onOut" OnMouseOver="onOver" OnMouseUp="onOver"><![CDATA[var background;
var text1;
var overClr, outClr, bgClr;

function onLoad(evt) {
	background = evt.getCurrentTarget().getChildByName("background");
	text1 = evt.getCurrentTarget().getChildByName("Text1");
	overClr = evt.getCurrentTarget().getAttribute("Fill");
	outClr = evt.getCurrentTarget().getChildByName("Text1").getAttribute("Stroke");
	bgClr = background.getAttribute("Stroke");
}

function onOver(evt) {
	background.setAttribute("Stroke", overClr);
	text1.setAttribute("Stroke", overClr);
	ani(evt.getCurrentTarget());
}

function onOut(evt) {
	background.setAttribute("Stroke", bgClr);
	text1.setAttribute("Stroke", outClr);
	ani(evt.getCurrentTarget());
}

function onDown(evt) {
	text1.setAttribute("Stroke", "#626469");
}

function onClick(evt) {
	evt.preventDefault();
	background.setAttribute("Stroke", "#FFFFFF");
	if (evt.getButton() != 0)
		return; //Not Left
	var component = evt.getCurrentTarget();
	var fbn = component.getChildByName("Link").getFullBindName();
	var target = String(component.getAttribute("linkTarget")).toLowerCase().charAt(0);
	switch (target) {
	case "n":
		invoke(fbn, "OpenInNewWindow");
		break;
	case "f":
    var reqLeft=parseInt(component.getAttribute("floatL"));
        var reqWidth=parseInt(component.getAttribute("floatW"));
            var reqTop=parseInt(component.getAttribute("floatT"));
                var reqHeight=parseInt(component.getAttribute("floatH"));
		invoke(fbn, "OpenInFloatingWindow ShowToolbar=No | Left="+reqLeft+" | Top="+reqTop+" | Width="+reqWidth+" | Height="+reqHeight+"");
        break;
	default:
		invoke(fbn, "OpenInSelf");
	}
}

function ani(c) {
	var ani = c.getElementsByTagName("Animate");
	var t;
	for (var i = 0; ani.length > i; i++) {
		ani.item(i).setAttribute("Animation", "Stop");
		t = ani.item(i).getAttribute("To");
		ani.item(i).setAttribute("To", ani.item(i).getAttribute("From"));
		ani.item(i).setAttribute("From", t);
		ani.item(i).setAttribute("Animation", "Start");
	}
}]]></Script>
